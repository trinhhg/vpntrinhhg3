    }

    // =========================================================
    // BANK NOTIFICATION PARSER
    // =========================================================

    function parseAmount(str) {
      let s = String(str).replace(/[^\d.,]/g, "");
      // Nếu có cả dấu . và , -> coi . là nghìn, , là thập phân (hoặc ngược lại tùy bank, MBBank thường dùng . cho nghìn)
      if (s.includes(".") && s.includes(",")) {
        s = s.replace(/\./g, "").replace(",", ".");
      } else {
        s = s.replace(/[,.]/g, "");
      }
      return Number(s);
    }

    function parseBankNotification(notification) {
      const raw = String(notification || "").trim();

      if (!raw) {
        return { amount: null, content: null, orderId: null, raw };
      }

      // Regex bắt số tiền: Tìm dấu '+' hoặc 'GD:' theo sau là các chữ số
      const amountMatch = raw.match(/GD\s*:\s*\+?\s*([\d,.]+)/i) || raw.match(/\+\s*([\d,.]+)\s*(?:VND|VNĐ|Đ)/i) || raw.match(/\+\s*([\d,.]+)/);
      let amount = null;

      if (amountMatch) {
        const parsedAmount = parseAmount(amountMatch[1]);
        if (Number.isSafeInteger(parsedAmount) && parsedAmount > 0) {
          amount = parsedAmount;
        }
      }

      // Nội dung: Lấy nguyên cục thô
      const contentMatch = raw.match(/ND\s*[:|]\s*(.*)$/is) || raw.match(/\|ND\s*(.*)$/is);
      const content = contentMatch ? contentMatch[1].trim() : raw;

      // FIX CASE B: Bắt mã Đơn hàng (Bỏ yêu cầu sau chữ ND, dọn dẹp trước khi bắt)
      const sanitizedRaw = raw.replace(/[-_.\s]/g, "").toUpperCase();
      const orderMatch = sanitizedRaw.match(/(DH[A-Z0-9]{10})/);
      const orderId = orderMatch ? normalizeOrderId(orderMatch[1]) : null;

      return { amount, content, orderId, raw };
    }

