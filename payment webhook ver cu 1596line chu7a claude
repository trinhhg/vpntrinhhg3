              paid_at TEXT,
              review_note TEXT,
              fulfillment_status TEXT DEFAULT 'pending'
            )
          `).run();

          const upgradeColumns = await env.DB
            .prepare(`PRAGMA table_info(order_upgrades)`)
            .all();

          const hasUpgradeFulfillment = (
            upgradeColumns.results || []
          ).some(
            column => column.name === "fulfillment_status"
          );

          if (!hasUpgradeFulfillment) {
            try {
              await env.DB.prepare(`
                ALTER TABLE order_upgrades
                ADD COLUMN fulfillment_status TEXT DEFAULT 'pending'
             `).run();
