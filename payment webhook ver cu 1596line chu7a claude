        LIMIT 1
      `)
        .bind(orderId, amount)
        .first();
    }

    async function findUnmatchedWithoutOrder(
      env,
      amount
    ) {
      return await env.DB.prepare(`
        SELECT
          id, order_id, amount, payment_method, content,
          notification, status, created_at
