    // =========================================================
    // SCHEMA
    // =========================================================

    try {
      await ensureSchema(env);
    } catch (error) {
      return json(
        { ok: false, error: "Database schema initialization failed", details: String(error?.message || error) },
        500
      );
    }

    // =========================================================
    // POST /api/test
    // =========================================================

    if (request.method === "POST" && url.pathname === "/api/test") {
      if (!isAuthorized(request, CONFIG.MB_WEBHOOK_SECRET)) {
        return json({ ok: false, error: "Unauthorized" }, 401);
      }
      let body;
      try { body = await request.json(); } catch { return json({ ok: false, error: "Invalid JSON" }, 400); }
      return json({ ok: true, message: "Authenticated POST received", received: body });
    }

    // =========================================================
    // POST /api/transactions/check (KV Architecture Normalization)
    // =========================================================

    if (request.method === "POST" && url.pathname === "/api/transactions/check") {
      if (!isAuthorized(request, CONFIG.WEB_API_SECRET2) && !isAuthorized(request, CONFIG.WEB_API_SECRET)) {
        return json({ ok: false, error: "Unauthorized" }, 401);
      }
      
      let body;
      try { body = await request.json(); } catch { return json({ ok: false, error: "Invalid JSON" }, 400); }

      const orderId = normalizeOrderId(body.orderId);
      const amount = Number(body.amount || body.totalVnd);

      if (!isValidOrderId(orderId)) return json({ ok: false, error: "Invalid orderId format" }, 400);
      if (!Number.isSafeInteger(amount) || amount <= 0) return json({ ok: false, error: "Invalid amount" }, 400);

      // Tìm giao dịch unmatched khớp mã đơn và tiền
      let matchedTx = await env.DB.prepare(`
        SELECT * FROM transactions
        WHERE status = 'unmatched' AND order_id = ? AND CAST(amount AS INTEGER) = CAST(? AS INTEGER)
        ORDER BY id ASC LIMIT 1
      `).bind(orderId, amount).first();

      // Vớt giao dịch unmatched duy nhất theo số tiền
      if (!matchedTx) {
        const sameAmountTxs = await env.DB.prepare(`
          SELECT * FROM transactions
          WHERE status = 'unmatched' AND CAST(amount AS INTEGER) = CAST(? AS INTEGER) AND (order_id IS NULL OR order_id = '')
        `).bind(amount).all();

        if (sameAmountTxs.results && sameAmountTxs.results.length === 1) {
          matchedTx = sameAmountTxs.results[0];
        }
      }

      if (matchedTx) {
        // Cập nhật transaction
        await env.DB.prepare(`
          UPDATE transactions
          SET status = 'success', order_id = ?, reviewed_at = datetime('now', '+7 hours'), review_note = 'Khớp từ API check payment KV Website'
          WHERE id = ? AND status = 'unmatched'
        `).bind(orderId, matchedTx.id).run();

        // Tạo order mồi (nếu chưa có) để Admin UI hoạt động bình thường, không bê cấu trúc KV
        const orderExists = await env.DB.prepare(`SELECT id FROM orders WHERE order_id = ? LIMIT 1`).bind(orderId).first();
        if (!orderExists) {
           await env.DB.prepare(`
             INSERT INTO orders (order_id, total_vnd, status, created_at, fulfillment_status)
             VALUES (?, ?, 'success', datetime('now', '+7 hours'), 'pending')
           `).bind(orderId, amount).run();
        } else {
           await env.DB.prepare(`UPDATE orders SET status = 'success', paid_at = datetime('now', '+7 hours') WHERE order_id = ?`).bind(orderId).run();
        }

        return json({ ok: true, matched: true, transaction: matchedTx });
      }

      return json({ ok: true, matched: false });
    }

    // =========================================================
    // POST /api/orders
    // =========================================================

    if (request.method === "POST" && url.pathname === "/api/orders") {
      if (!isAuthorized(request, CONFIG.WEB_API_SECRET)) return json({ ok: false, error: "Unauthorized" }, 401);

      let body;
      try { body = await request.json(); } catch { return json({ ok: false, error: "Invalid JSON" }, 400); }

      const orderId = normalizeOrderId(body.orderId);
      const totalVnd = Number(body.totalVnd);
      const email = body.email || null;
      const targetWeb = body.targetWeb || body.target_web || null;

      if (!isValidOrderId(orderId)) return json({ ok: false, error: "Invalid orderId format", expected: "DHXXXXXXXXXX", received: orderId }, 400);
      if (!Number.isSafeInteger(totalVnd) || totalVnd <= 0) return json({ ok: false, error: "Invalid totalVnd" }, 400);

      const existingOrder = await env.DB.prepare(`
        SELECT id, order_id, total_vnd, status, created_at, paid_at, reviewed_at, review_note, fulfillment_status, email, target_web
        FROM orders WHERE order_id = ? LIMIT 1
      `).bind(orderId).first();

      if (existingOrder) {
        // Hỗ trợ case order gửi đè webhook Total VND mới lúc chuẩn bị nâng cấp
        if (body.isUpgrade) {
            await env.DB.prepare(`UPDATE orders SET total_vnd = ? WHERE order_id = ? AND status = 'success'`).bind(totalVnd, orderId).run();
        }

        if (existingOrder.status === "pending") {
          const reconciliation = await reconcileOrderAfterCreation(env, orderId, totalVnd);

          if (reconciliation.matched) {
            const updatedOrder = await env.DB.prepare(`
              SELECT id, order_id, total_vnd, status, created_at, paid_at, reviewed_at, review_note, fulfillment_status
              FROM orders WHERE order_id = ? LIMIT 1
            `).bind(orderId).first();

            const push = await notifyFulfillmentReady(env, ctx, {
             orderIds: [orderId],
              reason: "payment_reconciled_after_order_creation",
            });

            return json({
              ok: true,
              status: "reconciled",
              orderId,
             totalVnd,
             orderStatus: updatedOrder?.status || "success",
             transactionId: reconciliation.transactionId,
             matchedBy: reconciliation.matchedBy,
             fulfillmentStatus: updatedOrder?.fulfillment_status || "pending",
             notification: push,
              order: updatedOrder,
            });
          }
        } else if (existingOrder.status === "success" && ["waiting_metadata", "retry", "pending_retry", "pending"].includes(existingOrder.fulfillment_status)) {
          const push = await notifyFulfillmentReady(env, ctx, { orderIds: [orderId], reason: "metadata_arrived_late_trigger" });
          return json({ ok: true, status: "re_triggered", order: existingOrder, notification: push });
        }

        return json({ ok: true, status: "exists", order: existingOrder });
      }

      const result = await env.DB.prepare(`
        INSERT INTO orders (order_id, total_vnd, status, created_at, fulfillment_status, email, target_web)
        VALUES (?, ?, 'pending', datetime('now', '+7 hours'), 'pending', ?, ?)
      `).bind(orderId, totalVnd, email, targetWeb).run();

      const reconciliation = await reconcileOrderAfterCreation(env, orderId, totalVnd);

      let finalStatus = reconciliation.matched ? "success" : "pending";
      let push = null;

      if (reconciliation.matched) {
        push = await notifyFulfillmentReady(env, ctx, {
          orderIds: [orderId],
          reason: "payment_reconciled_after_order_creation",
        });
      }

      return json({
        ok: true,
        status: "created",
        orderId,
        totalVnd,
        orderStatus: finalStatus,
        transactionId: reconciliation.transactionId || null,
        matchedBy: reconciliation.matchedBy || null,
       fulfillmentStatus: finalStatus === "success" ? "pending" : null,
        notification: push,
       createdAtTimezone: "Asia/Ho_Chi_Minh",
       orderDatabaseId: result.meta.last_row_id,
      });
    }

    // =========================================================
    // POST /api/upgrades
    // =========================================================

    if (request.method === "POST" && url.pathname === "/api/upgrades") {
      if (!isAuthorized(request, CONFIG.WEB_API_SECRET)) return json({ ok: false, error: "Unauthorized" }, 401);

      let body;
      try { body = await request.json(); } catch { return json({ ok: false, error: "Invalid JSON" }, 400); }

      const orderId = normalizeOrderId(body.orderId);
      const targetPackageId = String(body.targetPackageId || "").trim();

      if (!isValidOrderId(orderId)) return json({ ok: false, error: "Invalid orderId format", expected: "DHXXXXXXXXXX", received: orderId }, 400);
      const targetPackage = getPackage(targetPackageId);
      if (!targetPackage) return json({ ok: false, error: "Unknown target package", targetPackageId, availablePackages: Object.values(PACKAGES) }, 400);

      const order = await env.DB.prepare(`SELECT id, order_id, total_vnd, status, created_at, paid_at FROM orders WHERE order_id = ? LIMIT 1`).bind(orderId).first();
      if (!order) return json({ ok: false, error: "Order not found", orderId }, 404);
      if (order.status !== "success") return json({ ok: false, error: "Order is not eligible for upgrade", orderId, currentOrderStatus: order.status }, 409);

      const paidUpgradeResult = await env.DB.prepare(`SELECT COALESCE(SUM(upgrade_amount_vnd), 0) AS total_upgrade FROM order_upgrades WHERE order_id = ? AND status = 'success'`).bind(orderId).first();
      const paidUpgradeAmount = Number(paidUpgradeResult?.total_upgrade || 0);
      const currentPrice = Number(order.total_vnd) + paidUpgradeAmount;
      const targetPrice = Number(targetPackage.priceVnd);
      let upgradeAmount = targetPrice - currentPrice;
      
      // Override upgradeAmount nếu client gửi lên cụ thể
      if(body.amount && Number.isSafeInteger(Number(body.amount))) {
         upgradeAmount = Number(body.amount);
      }

      if (upgradeAmount <= 0) return json({ ok: false, error: "Target package is not higher than current package", orderId, currentPriceVnd: currentPrice, targetPackageId: targetPackage.packageId, targetPriceVnd: targetPrice, upgradeAmountVnd: upgradeAmount }, 409);

      const pendingUpgrade = await env.DB.prepare(`SELECT * FROM order_upgrades WHERE order_id = ? AND status = 'pending' ORDER BY id DESC LIMIT 1`).bind(orderId).first();
      if (pendingUpgrade) return json({ ok: true, status: "upgrade_already_pending", upgrade: pendingUpgrade });

      const result = await env.DB.prepare(`
        INSERT INTO order_upgrades (order_id, from_price_vnd, target_package_id, target_price_vnd, upgrade_amount_vnd, status, created_at, fulfillment_status)
        VALUES (?, ?, ?, ?, ?, 'pending', datetime('now', '+7 hours'), 'pending')
      `).bind(orderId, currentPrice, targetPackage.packageId, targetPrice, upgradeAmount).run();

      const upgradeId = result.meta.last_row_id;

      const earlyTx = await env.DB.prepare(`
        SELECT id FROM transactions WHERE order_id = ? AND status = 'unmatched' AND CAST(amount AS INTEGER) = CAST(? AS INTEGER) ORDER BY id ASC LIMIT 1
      `).bind(orderId, upgradeAmount).first();

      let finalStatus = "upgrade_pending";
      let push = null;

      if (earlyTx) {
        const updateTxRes = await env.DB.prepare(`
          UPDATE transactions SET status = 'success', reviewed_at = datetime('now', '+7 hours'), review_note = 'Khớp tự động - tiền nâng gói vào trước' WHERE id = ? AND status = 'unmatched'
       `).bind(earlyTx.id).run();

        if (updateTxRes.meta.changes > 0) {
          await env.DB.prepare(`
            UPDATE order_upgrades SET status = 'success', transaction_id = ?, paid_at = datetime('now', '+7 hours'), fulfillment_status = 'pending' WHERE id = ? AND status = 'pending'
         `).bind(earlyTx.id, upgradeId).run();

          finalStatus = "upgrade_success";
          push = await notifyFulfillmentReady(env, ctx, {
           upgradeIds: [upgradeId],
            orderIds: [orderId],
            reason: "upgrade_payment_reconciled",
          });
        }
      }

      return json({
        ok: true,
        status: finalStatus,
        upgradeId,
        orderId,
       currentPriceVnd: currentPrice,
        targetPackage: {
          packageId: targetPackage.packageId,
          name: targetPackage.name,
          duration: targetPackage.duration,
          priceVnd: targetPackage.priceVnd,
          traffic: targetPackage.traffic,
        },
       targetPriceVnd: targetPrice,
       upgradeAmountVnd: upgradeAmount,
       paymentInstruction: `Chuyển đúng ${upgradeAmount.toLocaleString("en-US")}VND với nội dung ${orderId}`,
       fulfillmentStatus: finalStatus === "upgrade_success" ? "pending" : null,
        notification: push,
        timezone: "Asia/Ho_Chi_Minh",
      });
    }

    // =========================================================
    // GET /api/upgrades/:orderId
    // =========================================================

    if (request.method === "GET" && url.pathname.startsWith("/api/upgrades/")) {
      if (!isAuthorized(request, CONFIG.WEB_API_SECRET)) return json({ ok: false, error: "Unauthorized" }, 401);

      const orderId = normalizeOrderId(decodeURIComponent(url.pathname.replace("/api/upgrades/", "")));
      if (!isValidOrderId(orderId)) return json({ ok: false, error: "Invalid orderId format", expected: "DHXXXXXXXXXX", received: orderId }, 400);

      const upgrades = await env.DB.prepare(`SELECT * FROM order_upgrades WHERE order_id = ? ORDER BY id DESC`).bind(orderId).all();
      const paidUpgradeResult = await env.DB.prepare(`SELECT COALESCE(SUM(upgrade_amount_vnd), 0) AS total_upgrade FROM order_upgrades WHERE order_id = ? AND status = 'success'`).bind(orderId).first();
      const order = await env.DB.prepare(`SELECT order_id, total_vnd, status FROM orders WHERE order_id = ? LIMIT 1`).bind(orderId).first();

      if (!order) return json({ ok: false, error: "Order not found", orderId }, 404);

      const currentPrice = Number(order.total_vnd) + Number(paidUpgradeResult?.total_upgrade || 0);

      return json({
        ok: true,
        orderId,
        orderStatus: order.status,
       originalPriceVnd: Number(order.total_vnd),
       currentPriceVnd: currentPrice,
       totalPaidUpgradeVnd: Number(paidUpgradeResult?.total_upgrade || 0),
        upgrades: upgrades.results || [],
        timezone: "Asia/Ho_Chi_Minh",
      });
    }

    // =========================================================
    // GET /api/orders/:orderId
    // =========================================================

    if (request.method === "GET" && url.pathname.startsWith("/api/orders/")) {
      if (!isAuthorized(request, CONFIG.WEB_API_SECRET)) return json({ ok: false, error: "Unauthorized" }, 401);

      const orderId = normalizeOrderId(decodeURIComponent(url.pathname.replace("/api/orders/", "")));
      if (!isValidOrderId(orderId)) return json({ ok: false, error: "Invalid orderId format", expected: "DHXXXXXXXXXX", received: orderId }, 400);

      const order = await env.DB.prepare(`
        SELECT order_id, total_vnd, status, created_at, paid_at, reviewed_at, review_note, fulfillment_status, email, target_web
        FROM orders WHERE order_id = ? LIMIT 1
     `).bind(orderId).first();

      if (!order) return json({ ok: false, error: "Order not found", orderId }, 404);

      const paidUpgradeResult = await env.DB.prepare(`SELECT COALESCE(SUM(upgrade_amount_vnd), 0) AS total_upgrade FROM order_upgrades WHERE order_id = ? AND status = 'success'`).bind(orderId).first();
      const currentPrice = Number(order.total_vnd) + Number(paidUpgradeResult?.total_upgrade || 0);

      return json({
        ok: true,
        orderId: order.order_id,
        totalVnd: Number(order.total_vnd),
        status: order.status,
        createdAt: order.created_at,
        paidAt: order.paid_at,
        reviewedAt: order.reviewed_at,
        reviewNote: order.review_note,
       fulfillmentStatus: order.fulfillment_status,
        email: order.email,
        targetWeb: order.target_web,
       originalPriceVnd: Number(order.total_vnd),
       totalPaidUpgradeVnd: Number(paidUpgradeResult?.total_upgrade || 0),
       currentPackagePriceVnd: currentPrice,
        timezone: "Asia/Ho_Chi_Minh",
      });
    }

    // =========================================================
    // GET /api/admin/transactions
    // =========================================================

    if (request.method === "GET" && url.pathname === "/api/admin/transactions") {
      if (!isAuthorized(request, CONFIG.WEB_API_SECRET)) return json({ ok: false, error: "Unauthorized" }, 401);

      const statusFilter = url.searchParams.get("status");
      const limit = Math.min(Number(url.searchParams.get("limit")) || 50, 100);
      const afterId = Number(url.searchParams.get("after_id"));
      const beforeId = Number(url.searchParams.get("before_id"));

      let baseQuery = `SELECT id, order_id, amount, payment_method, content, notification, status, created_at, reviewed_at, review_note FROM transactions`;
      const conditions = [];
      const params = [];

      if (statusFilter && statusFilter !== "all") {
        if (statusFilter === "review_required" || statusFilter === "success_review") {
         conditions.push(`status IN ('success_review', 'review_required')`);
        } else {
         conditions.push(`status = ?`);
         params.push(statusFilter);
        }
      }

      if (afterId) {
       conditions.push(`id > ?`);
       params.push(afterId);
        baseQuery += (conditions.length > 0 ? ` WHERE ${conditions.join(" AND ")}` : "") + ` ORDER BY id ASC LIMIT ?`;
       params.push(limit);
      } else if (beforeId) {
       conditions.push(`id < ?`);
       params.push(beforeId);
        baseQuery += (conditions.length > 0 ? ` WHERE ${conditions.join(" AND ")}` : "") + ` ORDER BY id DESC LIMIT ?`;
       params.push(limit);
      } else {
        // Lần đầu load hoặc load mặc định
        baseQuery += (conditions.length > 0 ? ` WHERE ${conditions.join(" AND ")}` : "") + ` ORDER BY id DESC LIMIT ?`;
       params.push(limit);
      }

      const result = await env.DB.prepare(baseQuery).bind(...params).all();

      const reviews = [];
      for (const transaction of result.results || []) {
        let candidateOrders = [];
        let matchedOrder = null;
        
        if (transaction.status === "review_required" || transaction.status === "success_review") {
          const candidates = await env.DB.prepare(`
            SELECT order_id, total_vnd, status, created_at FROM orders WHERE status = 'pending' AND CAST(total_vnd AS INTEGER) = CAST(? AS INTEGER) ORDER BY id DESC
         `).bind(transaction.amount).all();
         candidateOrders = candidates.results || [];
        }
        
        if (transaction.order_id) {
          matchedOrder = await env.DB.prepare(`
            SELECT order_id, total_vnd, status, created_at, paid_at, reviewed_at, review_note, fulfillment_status
            FROM orders WHERE order_id = ? LIMIT 1
         `).bind(transaction.order_id).first();
        }
        
        reviews.push({ ...transaction, candidateOrders, matchedOrder });
      }

      return json({ ok: true, count: reviews.length, transactions: reviews, serverTime: new Date().toISOString(), timezone: "Asia/Ho_Chi_Minh" });
    }

    // =========================================================
    // GET /api/admin/ready_to_fulfill
    // =========================================================

    if (request.method === "GET" && url.pathname === "/api/admin/ready_to_fulfill") {
      if (!isAuthorized(request, CONFIG.WEB_API_SECRET)) return json({ ok: false, error: "Unauthorized" }, 401);

      const newOrders = await env.DB.prepare(`
        SELECT order_id, total_vnd, status, created_at, paid_at, fulfillment_status, target_web FROM orders
        WHERE status = 'success' AND (fulfillment_status IS NULL OR fulfillment_status != 'fulfilled')
        ORDER BY datetime(paid_at) ASC, order_id ASC
      `).all();

      const upgrades = await env.DB.prepare(`
        SELECT id, order_id, target_price_vnd, target_package_id, upgrade_amount_vnd, status, paid_at, fulfillment_status
        FROM order_upgrades
        WHERE status = 'success' AND (fulfillment_status IS NULL OR fulfillment_status != 'fulfilled')
        ORDER BY datetime(paid_at) ASC, id ASC
      `).all();

      return json({
        ok: true,
        newOrders: newOrders.results || [],
        upgrades: upgrades.results || [],
        count: (newOrders.results || []).length + (upgrades.results || []).length,
        serverTime: new Date().toISOString(),
        timezone: "Asia/Ho_Chi_Minh",
      });
    }

    // =========================================================
    // POST /api/admin/claim_fulfillment
    // =========================================================

    if (request.method === "POST" && url.pathname === "/api/admin/claim_fulfillment") {
      if (!isAuthorized(request, CONFIG.WEB_API_SECRET)) return json({ ok: false, error: "Unauthorized" }, 401);
      
      let body;
      try { body = await request.json(); } catch { return json({ ok: false, error: "Invalid JSON" }, 400); }

      const orderIds = Array.isArray(body.orderIds) ? body.orderIds : [];
      const upgradeIds = Array.isArray(body.upgradeIds) ? body.upgradeIds : [];
      const claimedOrders = [];
      const claimedUpgrades = [];

      for (const oid of orderIds) {
        const orderId = normalizeOrderId(oid);
        if (!isValidOrderId(orderId)) continue;
        const result = await env.DB.prepare(`
          UPDATE orders SET fulfillment_status = 'processing'
          WHERE order_id = ? AND status = 'success' AND (fulfillment_status IS NULL OR fulfillment_status = 'pending')
       `).bind(orderId).run();
        if (result.meta.changes > 0) claimedOrders.push(orderId);
      }

      for (const uid of upgradeIds) {
        const upgradeId = Number(uid);
        if (!Number.isSafeInteger(upgradeId) || upgradeId <= 0) continue;
        const result = await env.DB.prepare(`
          UPDATE order_upgrades SET fulfillment_status = 'processing'
          WHERE id = ? AND status = 'success' AND (fulfillment_status IS NULL OR fulfillment_status = 'pending')
       `).bind(upgradeId).run();
        if (result.meta.changes > 0) claimedUpgrades.push(upgradeId);
      }

      return json({ ok: true, claimedOrders, claimedUpgrades, count: claimedOrders.length + claimedUpgrades.length });
    }

    // =========================================================
    // POST /api/admin/mark_fulfilled
    // =========================================================

    if (request.method === "POST" && url.pathname === "/api/admin/mark_fulfilled") {
      if (!isAuthorized(request, CONFIG.WEB_API_SECRET)) return json({ ok: false, error: "Unauthorized" }, 401);

      let body;
      try { body = await request.json(); } catch { return json({ ok: false, error: "Invalid JSON" }, 400); }

      const orderIds = Array.isArray(body.orderIds) ? body.orderIds : [];
      const upgradeIds = Array.isArray(body.upgradeIds) ? body.upgradeIds : [];
      const fulfilledOrders = [];
      const fulfilledUpgrades = [];

      for (const oid of orderIds) {
        const orderId = normalizeOrderId(oid);
        if (!isValidOrderId(orderId)) continue;
        const result = await env.DB.prepare(`
          UPDATE orders SET fulfillment_status = 'fulfilled'
          WHERE order_id = ? AND status = 'success' AND (fulfillment_status IS NULL OR fulfillment_status != 'fulfilled')
       `).bind(orderId).run();
        if (result.meta.changes > 0) fulfilledOrders.push(orderId);
      }

      for (const uid of upgradeIds) {
        const upgradeId = Number(uid);
        if (!Number.isSafeInteger(upgradeId) || upgradeId <= 0) continue;
        const result = await env.DB.prepare(`
          UPDATE order_upgrades SET fulfillment_status = 'fulfilled'
          WHERE id = ? AND status = 'success' AND (fulfillment_status IS NULL OR fulfillment_status != 'fulfilled')
       `).bind(upgradeId).run();
        if (result.meta.changes > 0) fulfilledUpgrades.push(upgradeId);
      }

      return json({ ok: true, fulfilledOrders, fulfilledUpgrades, count: fulfilledOrders.length + fulfilledUpgrades.length });
    }

    // =========================================================
    // POST /api/admin/reset_fulfillment
    // =========================================================

    if (request.method === "POST" && url.pathname === "/api/admin/reset_fulfillment") {
      if (!isAuthorized(request, CONFIG.WEB_API_SECRET)) return json({ ok: false, error: "Unauthorized" }, 401);

      let body;
      try { body = await request.json(); } catch { return json({ ok: false, error: "Invalid JSON" }, 400); }

      const orderIds = Array.isArray(body.orderIds) ? body.orderIds : [];
      const upgradeIds = Array.isArray(body.upgradeIds) ? body.upgradeIds : [];

      for (const oid of orderIds) {
        const orderId = normalizeOrderId(oid);
        if (!isValidOrderId(orderId)) continue;
        await env.DB.prepare(`
          UPDATE orders SET fulfillment_status = 'pending'
          WHERE order_id = ? AND status = 'success' AND fulfillment_status = 'processing'
       `).bind(orderId).run();
      }

      for (const uid of upgradeIds) {
        const upgradeId = Number(uid);
        if (!Number.isSafeInteger(upgradeId) || upgradeId <= 0) continue;
        await env.DB.prepare(`
          UPDATE order_upgrades SET fulfillment_status = 'pending'
          WHERE id = ? AND status = 'success' AND fulfillment_status = 'processing'
       `).bind(upgradeId).run();
      }

      return json({ ok: true });
    }

    // =========================================================
    // POST /api/admin/transactions/delete_batch
    // =========================================================

    if (request.method === "POST" && url.pathname === "/api/admin/transactions/delete_batch") {
      // Bảo mật lớp 1: Cô lập quyền xoá với Secret Key riêng biệt
      const deleteSecret = env.ADMIN_DELETE_SECRET || CONFIG.ADMIN_DELETE_SECRET;
      if (!isAuthorized(request, deleteSecret)) {
        return json({ ok: false, error: "Unauthorized: Yêu cầu quyền xóa giao dịch riêng biệt" }, 401);
      }

      let body;
      try { 
        body = await request.json(); 
      } catch { 
        return json({ ok: false, error: "Invalid JSON" }, 400); 
      }

      // Bảo mật lớp 2: Kiểm soát Payload
      const ids = body.ids;
      if (!Array.isArray(ids) || ids.length === 0) {
        return json({ ok: false, error: "Thiếu mảng 'ids' hoặc mảng rỗng" }, 400);
      }

      if (ids.length > 500) {
        return json({ ok: false, error: "Vượt quá giới hạn 500 ID mỗi lần xóa để bảo vệ hệ thống" }, 400);
      }

      // Lọc dọn ID bẩn, chỉ nhận số nguyên dương an toàn
      const validIds = ids.map(Number).filter(id => Number.isSafeInteger(id) && id > 0);
      if (validIds.length === 0) {
        return json({ ok: false, error: "Không có ID hợp lệ nào để xóa" }, 400);
      }

      const placeholders = validIds.map(() => '?').join(',');

      // Bảo mật lớp 3: Lò bát quái kẹp 2 khiên bảo vệ (Chưa khớp đơn VÀ Ra đời > 24h)
      const result = await env.DB.prepare(`
        DELETE FROM transactions
        WHERE id IN (${placeholders})
          AND (order_id IS NULL OR order_id = '')
          AND datetime(created_at) <= datetime('now', '+7 hours', '-24 hours')
     `).bind(...validIds).run();

      // Trạm Phân Tích Dữ Liệu
      const requested = validIds.length;
      const deleted = result.meta.changes;
      const blocked = requested - deleted;

      return json({
        ok: true,
        requested,
        deleted,
        blocked,
        message: `Đã yêu cầu xóa ${requested}. Thành công: ${deleted}. Bị chặn (đã gắn đơn hoặc < 24h): ${blocked}`
      });
    }

    // =========================================================
    // POST /api/mbbank
    // =========================================================

    if (request.method === "POST" && url.pathname === "/api/mbbank") {
      if (!isAuthorized(request, CONFIG.MB_WEBHOOK_SECRET)) return json({ ok: false, error: "Unauthorized" }, 401);

      let body;
      try { body = await request.json(); } catch { return json({ ok: false, error: "Invalid JSON" }, 400); }

      const notification = String(body.notification || "").trim();
      if (!notification) return json({ ok: false, error: "Missing notification" }, 400);

      const parsed = parseBankNotification(notification);
      const amount = parsed.amount;
      const content = parsed.content;
      const orderId = parsed.orderId;
      const paymentMethod = String(body.paymentMethod || "MBBank").trim();

      if (!Number.isSafeInteger(amount) || amount <= 0) {
        return json({ ok: false, error: "Amount not found or invalid", notification, parsed }, 400);
      }

      // QUY TẮC MÁU CHÓ: LUÔN LƯU TRANSACTION TRƯỚC VỚI STATUS LÀ 'RECEIVED' ĐỂ KHÔNG BAO GIỜ BỊ MẤT
      const transactionId = await insertTransaction(env, {
        orderId, 
        amount, 
        paymentMethod,
        content, 
        notification,
        status: "received" // Status nguyên thủy
      });

      // Kiểm tra xem Macrodroid có gửi spam trùng không (dựa đúng vào thông báo ngân hàng y hệt)
      const duplicate = await env.DB.prepare(`
        SELECT id, status FROM transactions WHERE notification = ? AND id != ? LIMIT 1
     `).bind(notification, transactionId).first();

      if (duplicate) {
        await updateTx(env, transactionId, "duplicate_payment", "Trùng thông báo từ webhook/app điện thoại");
        return json({ ok: true, status: "duplicate_payment", duplicate: true, transactionId, orderId, amount, parsed: { amount, orderId, content }, message: "Duplicate bank notification ignored" });
      }

      // NẾU CÓ MÃ ĐƠN HÀNG TRONG NỘI DUNG CHUYỂN KHOẢN
      if (orderId) {
        let order = await env.DB.prepare(`SELECT * FROM orders WHERE order_id = ? LIMIT 1`).bind(orderId).first();

        // --- CROSS-SYNC FIX: Fetch KV if order not found in D1 ---
        if (!order) {
          try {
            const res = await fetch(`${CONFIG.WEBSITE_WORKER_URL}/api/orders`, {
              headers: {
               "Authorization": `Bearer ${CONFIG.WEB_API_SECRET2}`
              }
            });
            if (res.ok) {
              const kvOrders = await res.json();
              const kvOrder = Array.isArray(kvOrders) ? kvOrders.find(o => o.id === orderId) : null;
              if (kvOrder) {
                // Khách có đơn ở KV! Auto tạo bên D1 để thông mạch.
                const kvAmount = Number(kvOrder.totalVnd || kvOrder.total_vnd) || amount;
                await env.DB.prepare(`
                INSERT INTO orders (order_id, total_vnd, status, created_at, fulfillment_status)
                VALUES (?, ?, 'pending', datetime('now', '+7 hours'), 'pending')
               `).bind(orderId, kvAmount).run();

                order = { order_id: orderId, total_vnd: kvAmount, status: 'pending', fulfillment_status: 'pending' };
              }
            }
          } catch (e) {
            // Ignore fetch error, để null để nhảy vào unmatched
          }
        }
        // --------------------------------------------------------

        if (!order) {
          await updateTx(env, transactionId, "unmatched", "Chưa tìm thấy mã đơn hàng - Đưa vào danh sách chờ tự động khớp");
          return json({ ok: true, status: "unmatched", reason: "Order not found yet - transaction saved for automatic reconciliation", transactionId, orderId, amount, parsed: { amount, orderId, content } });
        }

        // BẮT BỆNH: XỬ LÝ NHÁNH ĐƠN ĐÃ SUCCESS
        if (order.status === "success") {
          const pendingUpgrade = await env.DB.prepare(`SELECT * FROM order_upgrades WHERE order_id = ? AND status = 'pending' ORDER BY id DESC LIMIT 1`).bind(orderId).first();

          // Debug Logs như Grok yêu cầu
         console.log({
           parsedOrderId: orderId,
           parsedAmount: amount,
           orderFound: !!order,
           orderStatus: order?.status,
           orderTotal: order?.total_vnd,
           amountDiff: order ? Math.abs(amount - Number(order.total_vnd)) : null,
           pendingUpgrade: pendingUpgrade ? {
              id: pendingUpgrade.id,
             expected: pendingUpgrade.upgrade_amount_vnd
            } : null
          });

          if (pendingUpgrade) {
            const expectedAmount = Number(pendingUpgrade.upgrade_amount_vnd);

            if (Math.abs(amount - expectedAmount) > 1) {
              await updateTx(env, transactionId, "amount_mismatch", "Sai số tiền nâng gói");
              return json({ ok: true, status: "upgrade_amount_mismatch", transactionId, orderId, receivedAmount: amount, expectedUpgradeAmount: expectedAmount, targetPackageId: pendingUpgrade.target_package_id, targetPriceVnd: Number(pendingUpgrade.target_price_vnd), parsed: { amount, orderId, content } });
            }

            // Nâng gói thành công
            await updateTx(env, transactionId, "success", "Khớp thanh toán nâng gói thành công");
            const updateUpgrade = await env.DB.prepare(`
              UPDATE order_upgrades SET status = 'success', transaction_id = ?, paid_at = datetime('now', '+7 hours'), fulfillment_status = 'pending' WHERE id = ? AND status = 'pending'
           `).bind(transactionId, pendingUpgrade.id).run();

            if (updateUpgrade.meta.changes === 0) {
               await updateTx(env, transactionId, "already_processed", "Lỗi: Upgrade đã được xử lý");
               return json({ ok: true, status: "already_processed", transactionId, orderId, amount });
            }

            const targetPackage = getPackage(pendingUpgrade.target_package_id);
            const push = await notifyFulfillmentReady(env, ctx, { orderIds: [orderId], upgradeIds: [pendingUpgrade.id], reason: "upgrade_payment_confirmed" });

            return json({ ok: true, status: "upgrade_success", transactionId, upgradeId: pendingUpgrade.id, orderId, amount, upgradeAmountVnd: expectedAmount, targetPackageId: pendingUpgrade.target_package_id, targetPackage: targetPackage || null, currentPackagePriceVnd: Number(pendingUpgrade.target_price_vnd), orderStatus: "success", upgradeStatus: "success", fulfillmentStatus: "pending", notification: push, parsed: { amount, orderId, content }, timezone: "Asia/Ho_Chi_Minh", message: "Package upgrade payment confirmed successfully" });
          } else {
            // FIX TÀNG HÌNH: Đơn hàng đã thành công nhưng KHÔNG CÓ pending upgrade -> Đẩy vào unmatched thay vì already_success
            await updateTx(env, transactionId, "unmatched", "Đơn hàng đã thanh toán từ trước. Khoản tiền mới chưa rõ mục đích (có thể khách muốn nâng gói nhưng chưa tạo trên web)");
            return json({ ok: true, status: "unmatched", reason: "possible_upgrade", transactionId, orderId, amount, orderStatus: "success", fulfillmentStatus: order.fulfillment_status || "pending", parsed: { amount, orderId, content }, message: "Order already success, payment saved as unmatched for potential manual upgrade" });
          }
        }

        if (order.status === "failed") {
          await updateTx(env, transactionId, "invalid_order_status", "Đơn hàng đã bị từ chối/thất bại");
          return json({ ok: true, status: "invalid_order_status", transactionId, orderId, amount, currentOrderStatus: "failed", parsed: { amount, orderId, content } });
        }

        if (Math.abs(amount - Number(order.total_vnd)) > 1) {
          await updateTx(env, transactionId, "amount_mismatch", `Sai số tiền (Đơn: ${order.total_vnd}, Nhận: ${amount})`);
          return json({ ok: true, status: "amount_mismatch", transactionId, orderId, receivedAmount: amount, expectedAmount: Number(order.total_vnd), parsed: { amount, orderId, content } });
        }

        if (order.status !== "pending") {
          await updateTx(env, transactionId, "invalid_order_status", `Sai trạng thái đơn hàng: ${order.status}`);
          return json({ ok: true, status: "invalid_order_status", transactionId, orderId, amount, currentOrderStatus: order.status, parsed: { amount, orderId, content } });
        }

        // KHỚP NGON LÀNH (ĐƠN MỚI HOÀN TOÀN)
        await updateTx(env, transactionId, "success", "Khớp thanh toán thành công");
        const updateOrder = await env.DB.prepare(`
          UPDATE orders SET status = 'success', paid_at = datetime('now', '+7 hours'), fulfillment_status = 'pending' WHERE order_id = ? AND status = 'pending'
       `).bind(orderId).run();

        if (updateOrder.meta.changes === 0) {
           await updateTx(env, transactionId, "already_processed", "Đơn hàng vừa được process trước đó mili-giây");
           return json({ ok: true, status: "already_processed", transactionId, orderId, amount });
        }

        const updatedOrder = await env.DB.prepare(`SELECT order_id, total_vnd, status, paid_at, fulfillment_status FROM orders WHERE order_id = ? LIMIT 1`).bind(orderId).first();
        const push = await notifyFulfillmentReady(env, ctx, { orderIds: [orderId], reason: "original_payment_confirmed" });

        return json({ ok: true, status: "success", transactionId, orderId, amount, paymentMethod, orderStatus: updatedOrder?.status || "success", fulfillmentStatus: updatedOrder?.fulfillment_status || "pending", notification: push, parsed: { amount, orderId, content }, timezone: "Asia/Ho_Chi_Minh", message: "Payment confirmed successfully" });
      }

      // NẾU KHÔNG THẤY MÃ ĐƠN HÀNG (QUÉT SỐ TIỀN MÒ KIM ĐÁY BỂ)
      const candidatesResult = await env.DB.prepare(`
        SELECT id, order_id, total_vnd, status, created_at FROM orders WHERE status = 'pending' AND CAST(total_vnd AS INTEGER) = CAST(? AS INTEGER) ORDER BY id ASC
     `).bind(amount).all();

      const candidates = candidatesResult.results || [];

      if (candidates.length === 0) {
        await updateTx(env, transactionId, "unmatched", "Không tìm thấy mã đơn hàng hay số tiền chờ nào trùng");
        return json({ ok: true, status: "unmatched", transactionId, amount, paymentMethod, parsed: { amount, orderId: null, content }, message: "No pending order with matching amount" });
      }

      if (candidates.length > 1) {
        const candidateOrders = candidates.map(order => ({ order_id: order.order_id, total_vnd: Number(order.total_vnd), status: order.status, created_at: order.created_at }));
        await updateTx(env, transactionId, "review_required", "Nhiều đơn hàng có cùng số tiền. Cần Admin review");
        return json({ ok: true, status: "review_required", transactionId, amount, paymentMethod, candidateOrders, candidateCount: candidateOrders.length, reviewRequired: true, orderStatus: "pending", parsed: { amount, orderId: null, content }, message: "Multiple pending orders have the same amount. Admin confirmation required." });
      }

      const matchedOrder = candidates[0];
      await updateTx(env, transactionId, "success_review", "Tìm thấy 1 đơn duy nhất có số tiền trùng, chờ Admin kiểm tra", matchedOrder.order_id);

      return json({ ok: true, status: "success_review", transactionId, orderId: matchedOrder.order_id, amount, paymentMethod, matchedBy: "unique_pending_order_same_amount", reviewRequired: true, orderStatus: "pending", parsed: { amount, orderId: null, content }, timezone: "Asia/Ho_Chi_Minh", message: "Payment matched to unique pending order by amount and is awaiting admin review" });
    }

    // =========================================================
    // POST /api/internal/fulfillment_callback
    // =========================================================

    if (request.method === "POST" && url.pathname === "/api/internal/fulfillment_callback") {
      // Cho phép pass bằng 1 trong 2 secret (Website mang sang hoặc gọi cục bộ)
      if (!isAuthorized(request, CONFIG.WEB_API_SECRET2) && !isAuthorized(request, CONFIG.WEB_API_SECRET)) {
          return json({ ok: false, error: "Unauthorized" }, 401);
      }
      
      let body;
      try { body = await request.json(); } catch { return json({ ok: false, error: "Invalid JSON" }, 400); }

      const results = body.results || body;
      
      const updateOrderStatus = async (id, status) => {
          await env.DB.prepare(`UPDATE orders SET fulfillment_status = ? WHERE order_id = ? AND fulfillment_status != 'fulfilled'`).bind(status, id).run();
      };
      
      const updateUpgradeStatus = async (id, status) => {
          await env.DB.prepare(`UPDATE order_upgrades SET fulfillment_status = ? WHERE id = ? AND fulfillment_status != 'fulfilled'`).bind(status, id).run();
      };

      for (const oid of [...(results.fulfilled || []), ...(results.already_fulfilled || [])]) await updateOrderStatus(oid, 'fulfilled');
      for (const oid of (results.missing || [])) await updateOrderStatus(oid, 'waiting_metadata');
      for (const oid of (results.errors || [])) await updateOrderStatus(oid, 'retry');

      for (const uid of [
       ...(results.fulfilledUpgrades || []), ...(results.fulfilled_upgrades || []), 
       ...(results.already_fulfilledUpgrades || []), ...(results.already_fulfilled_upgrades || [])
      ]) await updateUpgradeStatus(uid, 'fulfilled');
      
      for (const uid of [...(results.missingUpgrades || []), ...(results.missing_upgrades || [])]) await updateUpgradeStatus(uid, 'waiting_metadata');
      for (const uid of [...(results.errorsUpgrades || []), ...(results.errors_upgrades || [])]) await updateUpgradeStatus(uid, 'retry');

      return json({ ok: true, message: "Fulfillment callback processed, states updated." });
    }

    // =========================================================
    // ADMIN APPROVE
    // =========================================================

    if (request.method === "POST" && /^\/api\/admin\/reviews\/\d+\/approve$/.test(url.pathname)) {
      if (!isAuthorized(request, CONFIG.WEB_API_SECRET)) return json({ ok: false, error: "Unauthorized" }, 401);

      const match = url.pathname.match(/^\/api\/admin\/reviews\/(\d+)\/approve$/);
      const reviewId = Number(match[1]);

      let body = {};
      try { body = await request.json(); } catch { body = {}; }

      const transaction = await env.DB.prepare(`SELECT id, order_id, amount, payment_method, content, notification, status, created_at FROM transactions WHERE id = ? LIMIT 1`).bind(reviewId).first();
      if (!transaction) return json({ ok: false, error: "Không tìm thấy giao dịch này", reviewId }, 404);

      let orderId = normalizeOrderId(body.orderId || transaction.order_id || "");
      if (!orderId) return json({ ok: false, error: "Cần nhập mã Đơn Hàng", transactionId: transaction.id }, 400);
      if (!isValidOrderId(orderId)) return json({ ok: false, error: "Sai định dạng. Phải là DH kèm đúng 10 ký tự", expected: "DHXXXXXXXXXX", received: orderId }, 400);

      let order = await env.DB.prepare(`SELECT id, order_id, total_vnd, status, created_at, paid_at FROM orders WHERE order_id = ? LIMIT 1`).bind(orderId).first();

      if (!order) {
        await env.DB.prepare(`
          INSERT INTO orders (order_id, total_vnd, status, created_at, fulfillment_status) VALUES (?, ?, 'pending', datetime('now', '+7 hours'), 'pending')
       `).bind(orderId, Number(transaction.amount)).run();
      }

      const reviewNote = String(body.note || "Được Duyệt Ép bởi Admin").trim();

      await env.DB.prepare(`
        UPDATE transactions SET order_id = ?, status = 'success', reviewed_at = datetime('now', '+7 hours'), review_note = ? WHERE id = ?
      `).bind(orderId, reviewNote, reviewId).run();

      await env.DB.prepare(`
        UPDATE orders SET status = 'success', paid_at = datetime('now', '+7 hours'), reviewed_at = datetime('now', '+7 hours'), review_note = ?, fulfillment_status = 'pending' WHERE order_id = ?
     `).bind(reviewNote, orderId).run();

      const push = await notifyFulfillmentReady(env, ctx, { orderIds: [orderId], reason: "admin_review_approved" });

      return json({ ok: true, status: "approved", transactionId: reviewId, orderId, amount: Number(transaction.amount), previousReviewStatus: transaction.status, orderStatus: "success", fulfillmentStatus: "pending", reviewStatus: "approved", notification: push, timezone: "Asia/Ho_Chi_Minh", message: "ÉP DUYỆT THÀNH CÔNG - ĐƠN ĐÃ VÀO READY_TO_FULFILL" });
    }

    // =========================================================
    // ADMIN REJECT
    // =========================================================

    if (request.method === "POST" && /^\/api\/admin\/reviews\/\d+\/reject$/.test(url.pathname)) {
      if (!isAuthorized(request, CONFIG.WEB_API_SECRET)) return json({ ok: false, error: "Unauthorized" }, 401);

      const match = url.pathname.match(/^\/api\/admin\/reviews\/(\d+)\/reject$/);
      const reviewId = Number(match[1]);

      let body = {};
      try { body = await request.json(); } catch { body = {}; }

      const transaction = await env.DB.prepare(`SELECT id, order_id, amount, payment_method, content, notification, status, created_at FROM transactions WHERE id = ? LIMIT 1`).bind(reviewId).first();
      if (!transaction) return json({ ok: false, error: "Không tìm thấy giao dịch này", reviewId }, 404);

      const reviewNote = String(body.note || "Bị Ép Từ Chối bởi Admin").trim();

      await env.DB.prepare(`UPDATE transactions SET status = 'rejected', reviewed_at = datetime('now', '+7 hours'), review_note = ? WHERE id = ?`).bind(reviewNote, reviewId).run();

      if (transaction.order_id) {
        const orderId = normalizeOrderId(transaction.order_id);
        await env.DB.prepare(`UPDATE orders SET status = 'failed', reviewed_at = datetime('now', '+7 hours'), review_note = ?, fulfillment_status = 'pending' WHERE order_id = ?`).bind(reviewNote, orderId).run();
      }

      return json({ ok: true, status: "rejected", transactionId: reviewId, amount: Number(transaction.amount), orderStatus: transaction.order_id ? "failed" : "unchanged", reviewStatus: "rejected", timezone: "Asia/Ho_Chi_Minh", message: "ÉP TỪ CHỐI THÀNH CÔNG!" });
    }

    // =========================================================
    // POST /api/admin/push_fulfillment
    // =========================================================

    if (request.method === "POST" && url.pathname === "/api/admin/push_fulfillment") {
      if (!isAuthorized(request, CONFIG.WEB_API_SECRET)) return json({ ok: false, error: "Unauthorized" }, 401);

      let body;
      try { body = await request.json(); } catch { body = {}; }

      const orderIds = Array.isArray(body.orderIds) ? body.orderIds : [];
      const upgradeIds = Array.isArray(body.upgradeIds) ? body.upgradeIds : [];

      const result = await notifyFulfillmentReady(env, ctx, { orderIds, upgradeIds, reason: "manual_test_push" });

      return json({ ok: true, notification: result });
    }

    // =========================================================
    // 404
    // =========================================================

    return json({ ok: false, error: "Not found", path: url.pathname }, 404);
  },
};
