    // =========================================================
    // RECONCILE PAYMENT AFTER ORDER CREATION
    // =========================================================

    async function reconcileOrderAfterCreation(
      env,
      orderId,
      totalVnd
    ) {
      const directTransaction = await findUnmatchedTransactionForOrder(
        env,
        orderId,
        totalVnd
      );

      if (directTransaction) {
        const updateTxRes = await env.DB.prepare(`
          UPDATE transactions
          SET
            status = 'success',
           reviewed_at = datetime('now', '+7 hours'),
           review_note = 'Khớp tự động - tiền vào trước'
          WHERE id = ? AND status = 'unmatched'
        `)
         .bind(directTransaction.id)
          .run();

        if (updateTxRes.meta.changes > 0) {
          await markOrderSuccess(
            env,
            orderId,
            "Khớp tự động - tiền vào trước"
          );

          return {
            matched: true,
           transactionId: directTransaction.id,
            matchedBy: "order_id_and_amount",
           paymentType: "original_order",
          };
        }
      }

      // Vớt theo số tiền nếu DH trống
      const pendingResult = await env.DB.prepare(`
        SELECT id, order_id, total_vnd, status, created_at
        FROM orders
        WHERE status = 'pending' AND CAST(total_vnd AS INTEGER) = CAST(? AS INTEGER)
        ORDER BY id ASC
      `)
       .bind(totalVnd)
        .all();

      const pendingOrders = pendingResult.results || [];

      if (pendingOrders.length === 1) {
        const unmatched = await findUnmatchedWithoutOrder(
          env,
          totalVnd
        );

        if (unmatched) {
          const updateTxRes = await env.DB.prepare(`
            UPDATE transactions
            SET
              order_id = ?,
              status = 'success',
             reviewed_at = datetime('now', '+7 hours'),
             review_note = 'Khớp tự động - tiền vào trước - khớp duy nhất theo số tiền'
            WHERE id = ? AND status = 'unmatched'
          `)
           .bind(orderId, unmatched.id)
            .run();

          if (updateTxRes.meta.changes > 0) {
            await markOrderSuccess(
              env,
              orderId,
              "Khớp tự động - tiền vào trước - khớp duy nhất theo số tiền"
            );

            return {
              matched: true,
             transactionId: unmatched.id,
             matchedBy: "unique_pending_order_and_amount",
             paymentType: "original_order",
            };
          }
        }
      }

      return { matched: false };
    }

    // =========================================================
    // MACRODROID & WEBSITE WORKER FULFILLMENT TRIGGERS
    // =========================================================

    async function notifyMacroDroid(env, payload) {
      const endpoint = String(env.MARCO_FULFILLMENT_WEBHOOK_URL || "").trim();
      if (!endpoint) return { sent: false, skipped: true, reason: "MARCO_FULFILLMENT_WEBHOOK_URL is not configured" };

      const secret = String(env.MARCO_FULFILLMENT_SECRET || "").trim();

      try {
        const headers = { "Content-Type": "application/json" };
        if (secret) headers.Authorization = `Bearer ${secret}`;

        const response = await fetch(endpoint, {
          method: "POST",
          headers,
          body: JSON.stringify({
            source: "payment-webhook",
            event: "fulfillment_ready",
            timestamp: new Date().toISOString(),
           ...payload,
          }),
        });

        const text = await response.text();
        return { sent: response.ok, status: response.status, response: text.slice(0, 1000) };
      } catch (error) {
        return { sent: false, error: String(error?.message || error) };
      }
    }

    // XỬ LÝ GỌI SANG WEBSITE WORKER ĐỂ CẤP LINK
    async function triggerWebsiteFulfillment(env, { orderIds = [], upgradeIds = [] }) {
      if (orderIds.length === 0 && upgradeIds.length === 0) return;

      const workerUrl = CONFIG.WEBSITE_WORKER_URL;
      const secret2 = CONFIG.WEB_API_SECRET2;

      for (const oid of orderIds) {
        await env.DB.prepare(`UPDATE orders SET fulfillment_status = 'processing' WHERE order_id = ? AND fulfillment_status != 'fulfilled'`).bind(oid).run();
      }
      for (const uid of upgradeIds) {
        await env.DB.prepare(`UPDATE order_upgrades SET fulfillment_status = 'processing' WHERE id = ? AND fulfillment_status != 'fulfilled'`).bind(uid).run();
      }

      let resp;
      try {
        resp = await fetch(`${workerUrl}/api/internal/auto_fulfill`, {
          method: "POST",
          headers: {
           "Content-Type": "application/json",
           "Authorization": `Bearer ${secret2}`
          },
          body: JSON.stringify({ orderIds, upgradeIds })
        });
      } catch (e) {
        for (const oid of orderIds) await env.DB.prepare(`UPDATE orders SET fulfillment_status = 'retry' WHERE order_id = ? AND fulfillment_status = 'processing'`).bind(oid).run();
        for (const uid of upgradeIds) await env.DB.prepare(`UPDATE order_upgrades SET fulfillment_status = 'retry' WHERE id = ? AND fulfillment_status = 'processing'`).bind(uid).run();
        return;
      }

      if (!resp.ok) {
        for (const oid of orderIds) await env.DB.prepare(`UPDATE orders SET fulfillment_status = 'retry' WHERE order_id = ? AND fulfillment_status = 'processing'`).bind(oid).run();
        for (const uid of upgradeIds) await env.DB.prepare(`UPDATE order_upgrades SET fulfillment_status = 'retry' WHERE id = ? AND fulfillment_status = 'processing'`).bind(uid).run();
        return;
      }

      let data;
      try {
        data = await resp.json();
      } catch(e) {
         for (const oid of orderIds) await env.DB.prepare(`UPDATE orders SET fulfillment_status = 'retry' WHERE order_id = ? AND fulfillment_status = 'processing'`).bind(oid).run();
         for (const uid of upgradeIds) await env.DB.prepare(`UPDATE order_upgrades SET fulfillment_status = 'retry' WHERE id = ? AND fulfillment_status = 'processing'`).bind(uid).run();
         return;
      }

      const results = data.results || { fulfilled: [], missing: [], errors: [], already_fulfilled: [] };

      const updateOrderStatus = async (id, status) => {
        await env.DB.prepare(`UPDATE orders SET fulfillment_status = ? WHERE order_id = ? AND fulfillment_status != 'fulfilled'`).bind(status, id).run();
      };
      
      const updateUpgradeStatus = async (id, status) => {
        await env.DB.prepare(`UPDATE order_upgrades SET fulfillment_status = ? WHERE id = ? AND fulfillment_status != 'fulfilled'`).bind(status, id).run();
      };

      for (const oid of [...(results.fulfilled || []), ...(results.already_fulfilled || [])]) await updateOrderStatus(oid, 'fulfilled');
      for (const oid of (results.missing || [])) await updateOrderStatus(oid, 'waiting_metadata');
      for (const oid of (results.errors || [])) await updateOrderStatus(oid, 'retry');

      for (const uid of [
       ...(results.fulfilledUpgrades || []), ...(results.fulfilled_upgrades || []), 
       ...(results.already_fulfilledUpgrades || []), ...(results.already_fulfilled_upgrades || [])
      ]) await updateUpgradeStatus(uid, 'fulfilled');
      
      for (const uid of [...(results.missingUpgrades || []), ...(results.missing_upgrades || [])]) await updateUpgradeStatus(uid, 'waiting_metadata');
      for (const uid of [...(results.errorsUpgrades || []), ...(results.errors_upgrades || [])]) await updateUpgradeStatus(uid, 'retry');
    }

    async function notifyFulfillmentReady(env, ctx, { orderIds = [], upgradeIds = [], reason = "payment_confirmed" }) {
      if (orderIds.length === 0 && upgradeIds.length === 0) return { sent: false, skipped: true };

     ctx.waitUntil(notifyMacroDroid(env, { reason, orderIds, upgradeIds }));
     ctx.waitUntil(triggerWebsiteFulfillment(env, { orderIds, upgradeIds }));

      return { triggered: true, worker_sync: "background" };
    }

    // =========================================================
