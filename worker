// ====================================================================
// CRON (mỗi 15 phút): khóa link, luân chuyển node (MỖI LẦN CRON CHẠY), mail (19h), dọn "Đã xóa" > 48h, thử lại đăng ký D1
// persist() đã tự lọc tombstone nên link vừa bị admin xóa không thể bị cron ghi sống lại, kể cả khi state được load trước lúc admin xóa.
// ====================================================================
async function runCron(env, ctx, opt) {
  const KV = env.VPN_KV_TEST || env.VPN_KV, log = mkLog();
  if (opt.sim !== undefined) { SIM_OFF = opt.sim ? Number(opt.simOffset) || 0 : 0; SIM_T = Date.now(); } else { SIM_T = 0; await syncClock(KV); }
  const now = NOW();
  const st = await loadAll(KV), s = st.cms.settings || {}, me = getMe(null, env, st.cms);
  const hr = vn(now).h, today = dmy(now);
  let locked = 0, migrated = 0, delNodes = 0, mails = 0, d1Retry = 0, deadDel = 0;

  // 1. Khóa link: (giờ:phút tạo link − 3 tiếng) của ngày hết hạn
  for (const l of st.links) {
    if (!l || l.isLocked || !l.expDate || isLifetime(l.expDate)) continue;
    if (now >= lockAt(l.expDate, linkTs(l) || now)) { lockLink(l); locked++; st.dL = true; log("warn", "cron", "Khóa link hết hạn", `${l.email} · HSD ${l.expDate}`, l.orderId); }
  }

  if (opt.force || SIM_OFF !== 0) {
    const live = st.links.filter((l) => l && !l.isLocked && l.expDate && !isLifetime(l.expDate)), next = live.length ? Math.min(...live.map((l) => lockAt(l.expDate, linkTs(l) || now))) : 0;
    log("info", "cron", "Kiểm tra khóa link", `giờ hệ thống ${fmtBank(now)}${SIM_OFF !== 0 ? " (GIỜ TÙY CHỈNH)" : ""} · ${live.length} link còn hoạt động${next ? " · sắp khóa gần nhất lúc " + fmtBank(next) : ""}`);
  }
  // 2. Luân chuyển node sắp hết hạn / hết dung lượng — quét MỖI LẦN cron chạy (mỗi 15 phút)
  if (s.autoMigrateNode !== false) {
    const dying = st.pool.filter((p) => isDying(p));
    for (const dn of dying) {
      let broken = false;
      for (const l of st.links.filter((x) => x && x.orig === dn.url && !x.isLocked)) {
        const tn = pickNode(st.pool.filter((p) => !dying.includes(p)));
        if (!tn) { broken = true; break; }
        l.orig = tn.url; dn.used--; tn.used = (Number(tn.used) || 0) + 1; migrated++; st.dL = true;
      }
      if (!broken && Number(dn.used || 0) <= 0) { st.pool = st.pool.filter((p) => p.url !== dn.url); delNodes++; st.dL = true; log("info", "cron", "Xóa node rỗng hết hạn", dn.url.slice(0, 40)); }
    }
    if (migrated) log("ok", "cron", "Luân chuyển node", `${migrated} link sang node mới`);
    if (dying.length && !migrated && !delNodes) log("warn", "cron", "Có node sắp hết nhưng không có node dự phòng", `${dying.length} node`);
  }

  // 3. Mail nhắc hết hạn (19h VN, D-2 và D-1) — chỉ chạy khi Master
  if ((hr === 19 || opt.force === "mail") && s.autoMailEnabled && s.emailRole === "master") {
    const t0 = day0(now);
    for (const o of st.orders) {
      if (!o || normStatus(o.status) !== "success" || !o.email || !o.expDate || isLifetime(o.expDate)) continue;
      const dl = Math.round((parseDmy(o.expDate) - t0) / 864e5);
      if (dl !== 1 && dl !== 2) continue;
      const key = `${dl}D_${today}`; if (o.lastMailTrack === key) continue;
      const msg = dl === 1 ? "**ngày mai hết hạn**" : `còn **${dl} ngày** (hết hạn **${o.expDate}**)`;
      ctx.waitUntil(sendMail(o.email, sysSubject(st.cms, "exp", o, { expText: msg.replace(/\*\*/g, "") }), buildExpMailHtml(o, msg, me.PD, st.cms), env, st.cms));
      o.lastMailTrack = key; st.dO = true; mails++; log("ok", "mail", "Gửi mail nhắc hết hạn", `${o.email} (D-${dl})`, o.id);
    }
  }

  // 4. Dọn tab "Đã xóa" quá 48h (giữ tombstone dài hơn — xem TOMB_TTL)
  let dead = arr(safeJson(await KV.get("DEAD_LINKS"), []));
  const keep = dead.filter((d) => now - (Number(d.deadTs) || parseAny(d.deadDate) || now) <= 48 * 36e5);
  if (keep.length !== dead.length) { deadDel = dead.length - keep.length; await KV.put("DEAD_LINKS", JSON.stringify(keep)); log("info", "cron", "Dọn link đã xóa quá 48h", `${deadDel} link`); }

  // 5. Thử lại đăng ký D1 cho đơn chuyển khoản còn chờ (24h gần nhất) và yêu cầu nâng gói chờ
  const pend = st.orders.filter((o) => o && normStatus(o.status) === "pending" && isBankMethod(o.method) && now - (o.createdTs || 0) < 864e5).slice(0, 12);
  for (const o of pend) { const r = await d1Register(env, { origin: o.workerUrl || env.PUBLIC_WORKER_URL || "" }, o, o.orderType || "new"); if (r.ok) d1Retry++; }
  for (const o of st.orders.filter((x) => x && x.pendingUpgrade && isBankMethod(x.pendingUpgrade.method || x.method) && x.pendingUpgrade.amount).slice(0, 6)) await d1Upgrade(env, null, o, o.pendingUpgrade);

  await persist(KV, st);
  const sum = { ts: now, real: Date.now(), sim: SIM_OFF !== 0, locked, migrated, delNodes, mails, deadDel, d1Retry };
  await KV.put("CRON_LAST_RUN", JSON.stringify(sum));
  if (locked || migrated || delNodes || mails || deadDel || opt.force || (vn(now).mi < 15 && hr % 6 === 0)) log("ok", "cron", "Cron chạy xong", `khóa ${locked} · luân chuyển ${migrated} · xóa node ${delNodes} · mail ${mails} · dọn ${deadDel} · thử lại D1 ${d1Retry}`);
  await flushLog(KV, log);
  return sum;
}

function buildGlobalRouter(links) {
  const r = {};
  if (!Array.isArray(links)) return r;
  for (const l of links) {
    try {
      if (!l || !l.masked) continue;
      const mt = getParam(new URL(l.masked), "OwO", "token");
      if (l.isLocked && mt && (!l.orig || l.orig === LOCK_ORIG)) { r[mt] = { origTok: "", origUrl: "", isLocked: true }; continue; }
      if (!l.orig) continue;
      const ot = getParam(new URL(l.orig), "OwO", "token");
      if (mt && ot) r[mt] = { origTok: ot, origUrl: l.orig, isLocked: !!l.isLocked };
    } catch { /* bỏ qua link lỗi */ }
  }
  return r;
}
function getParam(url, ...keys) { for (const k of keys) { const v = url.searchParams.get(k); if (v) return v; } return null; }

