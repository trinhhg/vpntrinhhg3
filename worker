}
// Tìm link còn sống khớp nhất cho 1 đơn: ưu tiên orderId trùng, rồi cùng email + hạn giống hệt (kể cả Vĩnh viễn), rồi cùng email.
function matchLink(links, od) {
  const em = String(od.email || "").toLowerCase(), ek = expKey(od.expDate);
  return links.find((x) => x && !x.isLocked && x.orderId === od.id)
    || links.find((x) => x && !x.isLocked && String(x.email || "").toLowerCase() === em && expKey(x.expDate) === ek)
    || links.find((x) => x && !x.isLocked && String(x.email || "").toLowerCase() === em)
    || null;
}
// Map lại: chỉ đơn còn hạn, khớp email + hạn. Info của web mình dùng dữ liệu cục bộ; Info của web khác hỏi TỪNG vệ tinh qua /api/internal/links_lookup
// (mỗi vệ tinh tự xác định field của chính nó và trả field đó lại — admin không cần biết trước web nào giữ Info nào).
async function relinkMap(env, url, st, me, o) {
  const now = NOW(), fields = arr(o.fields).length ? o.fields.map(Number) : [1, 2, 3], items = []; let remoteOk = true;
  const wantRemote = fields.some((i) => "info" + i !== me.field);
  const remoteByField = {}; // "info2" -> Map(orderId -> {to, curAlive})
  if (wantRemote) {
    const cand = st.orders.filter((od) => od && normStatus(od.status) === "success" && !isExpiredOrder(od, now) && od.email);
    const t = syncTargets(st.cms, url);
    if (!t.length || !env.WEB_API_SECRET2) remoteOk = false;
    else for (const u of t) {
      try {
        const payload = cand.map((od) => ({ id: od.id, email: od.email, expDate: od.expDate, cur1: od.info1 || "", cur2: od.info2 || "", cur3: od.info3 || "" }));
        const r = await internalPost(env, u, "/api/internal/links_lookup", { orders: payload });
        const j = await r.json(); if (j && j.field && arr(j.results).length) remoteByField[j.field] = new Map(j.results.map((x) => [x.id, x]));
        else if (!j || j.ok === false) remoteOk = false;
      } catch { remoteOk = false; }
    }
  }
  for (const od of st.orders) {
    if (!od || normStatus(od.status) !== "success" || isExpiredOrder(od, now) || !od.email) continue;
    for (const i of fields) {
      const f = "info" + i; if (!o.includeManual && od.lockInfo && od.lockInfo[f]) continue;
      const cur = od[f];
      if (f === me.field) {
        if (cur && st.links.some((l) => l && l.masked === cur)) continue;
        const l = matchLink(st.links, od); if (l && l.masked !== cur) items.push({ id: od.id, email: od.email, field: f, link: cur || "", to: l.masked });
      } else {
        const mp = remoteByField[f]; if (!mp) continue; const hit = mp.get(od.id); if (!hit || !hit.to) continue;
        if (hit.curAlive && cur === hit.to) continue; items.push({ id: od.id, email: od.email, field: f, link: cur || "", to: hit.to });
      }
    }
  }
  return { items, remoteOk };
}

