function clearMasked(st, list) {
  const set = new Set(arr(list).filter(Boolean)); let n = 0;
  for (const o of st.orders) { if (!o) continue; for (const f of ["info1", "info2", "info3"]) if (o[f] && set.has(o[f])) { o[f] = ""; if (o.lockInfo) delete o.lockInfo[f]; n++; } }
  return n;
}
async function unlinkEverywhere(env, url, cms, masked) {
  const list = [...new Set(arr(masked).filter(Boolean))]; if (!list.length || !env.WEB_API_SECRET2) return;
  await Promise.all(syncTargets(cms, url).map((u) => internalPost(env, u, "/api/internal/unlink", { masked: list }).catch(() => {})));
}
async function relinkScan(env, url, st, o) {
  const now = NOW(), me = getMe(url, env, st.cms), fields = arr(o.fields).length ? o.fields.map(Number) : [1, 2, 3];
  const own = new Set(st.links.map((l) => l && l.masked).filter(Boolean)), other = [];
  for (const od of st.orders) for (const i of fields) { const f = "info" + i; if (od && f !== me.field && /^https?:\/\//.test(od[f] || "")) other.push(od[f]); }
  const remote = new Set(); let remoteOk = true;
  if (other.length) {
    const t = syncTargets(st.cms, url), list = [...new Set(other)];
    if (!t.length || !env.WEB_API_SECRET2) remoteOk = false;
    else for (const u of t) { try { const r = await internalPost(env, u, "/api/internal/links_exist", { masked: list }); const j = await r.json(); for (const x of arr(j.exist)) remote.add(x); } catch { remoteOk = false; } }
  }
  const items = [];
  for (const od of st.orders) {
    if (!od) continue;
    const expired = isExpiredOrder(od, now);
    if (o.expired === "expired" && !expired) continue;
    if (o.expired === "active" && expired) continue;
    for (const i of fields) {
      const f = "info" + i, v = od[f]; if (!v) continue;
      const manual = !!(od.lockInfo && od.lockInfo[f]); if (manual && !o.includeManual) continue;
      const isUrl = /^https?:\/\//.test(v);
      const dead = !isUrl ? true : f === me.field ? !own.has(v) : (remoteOk ? !(remote.has(v) || own.has(v)) : false);
      if (o.scope === "dead" && !dead) continue;
      items.push({ id: od.id, email: od.email || "", field: f, link: v, expired, dead, manual });
    }
