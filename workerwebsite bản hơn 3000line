// v3.5 - Hub & Spoke Kế Toán Mù, Cross-Web Sync & Auto Sub, Format 60,000VND - 2026-09-10

export default {
  async fetch(request, env, ctx) {
    const CORS = {
      "Access-Control-Allow-Origin": "*",
      "Access-Control-Allow-Methods": "GET,HEAD,POST,OPTIONS,DELETE",
      "Access-Control-Allow-Headers": "Content-Type,Authorization",
    };

    if (request.method === "OPTIONS") {
      return new Response(null, {
        status: 204,
        headers: CORS
      });
    }

    const url = new URL(request.url);
    const KV = env.VPN_KV_TEST || env.VPN_KV;

    if (!KV) {
      return new Response("LỖI: Chưa kết nối kho KV", {
        status: 500,
        headers: CORS
      });
    }

    const getP = (u, ...keys) => {
      for (const k of keys) {
        const v = u.searchParams.get(k);
        if (v) return v;
      }
      return null;
    };

    const jsonResponse = (data, status = 200) => {
      return new Response(JSON.stringify(data), {
        status,
        headers: {
          ...CORS,
          "Content-Type": "application/json; charset=utf-8"
        }
      });
    };

    const okResp = () => {
      return new Response("OK", {
        status: 200,
        headers: CORS
      });
    };

    const b64e = (str) => {
      const bytes = new TextEncoder().encode(str);
      let bin = "";

      for (const b of bytes) {
        bin += String.fromCharCode(b);
      }

      return btoa(bin);
    };

    // ================================================================
    // GITHUB ACTIONS
    // ================================================================

    if (
      url.pathname === "/api/trigger_github" &&
      request.method === "POST"
    ) {
      try {
        const { repo, workflow } = await request.json();

        if (!env.GH_PAT) {
          return new Response("Chưa cấu hình GH_PAT!", {
            status: 500,
            headers: CORS
          });
        }

        if (!repo || !workflow) {
          return new Response("Thiếu repo hoặc workflow!", {
            status: 400,
            headers: CORS
          });
        }

        const ghUrl = `https://api.github.com/repos/${repo}/actions/workflows/${workflow}/dispatches`;

        const r = await fetch(ghUrl, {
          method: "POST",
          headers: {
            "Accept": "application/vnd.github+json",
            "Authorization": `Bearer ${env.GH_PAT}`,
            "User-Agent": "VPN-TrinhHg-Cloudflare-Worker",
            "Content-Type": "application/json"
          },
          body: JSON.stringify({
            ref: "main"
          })
        });

        if (!r.ok) {
          return new Response(await r.text(), {
            status: r.status,
            headers: CORS
          });
        }

        return okResp();

      } catch (e) {
        return new Response(e?.message || "GitHub error", {
          status: 500,
          headers: CORS
        });
      }
    }

    // ================================================================
    // CRONJOB: QUÉT RÁC & LUÂN CHUYỂN NODE (HTTP Trigger)
    // ================================================================
    if (
      url.pathname === "/api/internal/cron" &&
      request.method === "POST"
    ) {
      const auth = request.headers.get("Authorization");
      if (!env.WEB_API_SECRET2 || auth !== `Bearer ${env.WEB_API_SECRET2}`) {
        return jsonResponse({ ok: false, error: "Unauthorized" }, 401);
      }
      try {
        const res = await runCron(KV);
        return jsonResponse({ ok: true, msg: "Cron executed successfully", details: res });
      } catch (e) {
        return jsonResponse({ ok: false, error: e?.message || "Cron error" }, 500);
      }
    }

    // ================================================================
    // GARBAGE COLLECTION
    // ================================================================

    if (
      url.pathname === "/api/gc" &&
      request.method === "POST"
    ) {
      try {
        const legacyPrefixes = [
          "MAP_",
          "SUB_DATA_",
          "ORIG_URL_",
          "LOCK_"
        ];

        const keysToDelete = [];
        let cursor = "";

        do {
          const list = await KV.list({
            cursor: cursor || undefined
          });

          for (const key of list.keys) {
            if (
              legacyPrefixes.some(prefix =>
                key.name.startsWith(prefix)
              )
            ) {
              keysToDelete.push(key.name);
            }
          }

          cursor = list.list_complete
            ? ""
            : (list.cursor || "");

        } while (cursor);

        for (let i = 0; i < keysToDelete.length; i += 50) {
          const chunk = keysToDelete.slice(i, i + 50);

          await Promise.all(
            chunk.map(k => KV.delete(k))
          );
        }

        return jsonResponse({
          deleted: keysToDelete.length,
          msg: "Legacy keys cleaned"
        });

      } catch (e) {
        return new Response(e?.message || "GC error", {
          status: 500,
          headers: CORS
        });
      }
    }

    // ================================================================
    // CROSS-WEB TRIGGER (Luồng 3 - Đồng bộ ngang cấp Link Chéo)
    // ================================================================
    if (
      url.pathname === "/api/internal/cross_sync_order" &&
      request.method === "POST"
    ) {
      const auth = request.headers.get("Authorization");

      if (!env.WEB_API_SECRET2 || auth !== `Bearer ${env.WEB_API_SECRET2}`) {
        return jsonResponse({ ok: false, error: "Unauthorized" }, 401);
      }

      try {
        const body = await request.json();
        const incomingOrders = body.orders || [];
        if (incomingOrders.length === 0) {
          return okResp();
        }

        let ordersDb = safeJson(await KV.get("ALL_ORDERS"), []);
        let linksDb = safeJson(await KV.get("ALL_LINKS"), []);
        let linkPoolDb = safeJson(await KV.get("LINK_POOL"), []);
        
        let PD = url.origin;
        let targetInfoField = "info1"; 
        if (PD.includes("doicucden")) { PD = "https://vpntrinhhg.pages.dev"; targetInfoField = "info1"; }
        else if (PD.includes("onepiecechapter")) { PD = "https://vpntrinhhg2.pages.dev"; targetInfoField = "info2"; }
        else if (PD.includes("lucastanora")) { PD = "https://vpntrinhhg3.pages.dev"; targetInfoField = "info3"; }

        for (const pool of linkPoolDb) {
          pool.used = linksDb.filter(x => x && x.orig === pool.url).length;
        }

        let kvChanged = false;

        for (const incOrder of incomingOrders) {
          let o = ordersDb.find(x => x && normalizeOrderId(x.id) === normalizeOrderId(incOrder.id));
          
          if (!o) {
            o = incOrder;
            ordersDb.unshift(o);
            kvChanged = true;
          } else {
            Object.assign(o, incOrder);
            kvChanged = true;
          }

          if (o.status === "success" && !o[targetInfoField] && !o.upgradeFulfilled && !o.upgrade_fulfilled) {
            let node = getPriorityNode(linkPoolDb);
            if (node) {
              const idx = linksDb.filter(x => x && x.orig === node.url).length + 1;
              const genHex = (len) => {
                const bytes = new Uint8Array(Math.ceil(len / 2));
                crypto.getRandomValues(bytes);
                let out = "";
                for (const b of bytes) out += b.toString(16).padStart(2, "0");
                return out.slice(0, len);
              };
              let qs;
              if (String(node.url).includes("liangxin")) {
                qs = `?OwO=${genHex(32)}`;
              } else {
                qs = `?token=${genHex(32)}`;
              }
              const basePath = String(node.url).includes("liangxin") ? "/v1/VPNTrinhHg" : "/v2/VPNTrinhHg";
              const masked = PD + basePath + qs + "#VPNTrinhHg";

              const vnTime = new Date(Date.now() + 7 * 3600 * 1000);
              const hh = String(vnTime.getUTCHours()).padStart(2, "0");
              const mm = String(vnTime.getUTCMinutes()).padStart(2, "0");
              const DD = String(vnTime.getUTCDate()).padStart(2, "0");
              const MM = String(vnTime.getUTCMonth() + 1).padStart(2, "0");
              const YYYY = vnTime.getUTCFullYear();
              const dateStr = `${hh}:${mm} - ${DD}/${MM}/${YYYY}`;

              const prefix = o.email ? String(o.email).split("@")[0] : "Khach";

              const newLink = {
                id: "LNK-" + Date.now() + genHex(6),
                orderId: o.id,
                pkg: o.pkgName || o.pkg || "",
                customerName: o.name || o.customerName || prefix,
                orig: node.url,
                masked,
                email: prefix,
                expDate: o.expDate || "",
                linkIndex: String(idx),
                isLocked: false,
                date: dateStr
              };

              linksDb.unshift(newLink);
              node.used = Number(node.used || 0) + 1;

              o[targetInfoField] = masked;
              kvChanged = true;
            }
          }
        }

        if (kvChanged) {
          await KV.put("ALL_ORDERS", JSON.stringify(ordersDb));
          await KV.put("ALL_LINKS", JSON.stringify(linksDb));
          await KV.put("LINK_POOL", JSON.stringify(linkPoolDb));

          const globalRouter = buildGlobalRouter(linksDb);
          await KV.put("GLOBAL_ROUTER", JSON.stringify(globalRouter));
        }

        return okResp();

      } catch (e) {
        return jsonResponse({ ok: false, error: e?.message || "Cross sync error" }, 500);
      }
    }

    // ================================================================
    // SERVER-SIDE AUTO FULFILLMENT (ONE PIPELINE)
    // ================================================================

    if (
      url.pathname === "/api/internal/auto_fulfill" &&
      request.method === "POST"
    ) {
      const auth = request.headers.get("Authorization");

      if (
        !env.WEB_API_SECRET2 ||
        auth !== `Bearer ${env.WEB_API_SECRET2}`
      ) {
        return jsonResponse({
          ok: false,
          error: "Unauthorized"
        }, 401);
      }

      // GLOBAL FULFILLMENT LOCK (Concurrency Protection)
      const isLocked = await KV.get("GLOBAL_FULFILL_LOCK");
      if (isLocked) {
        return jsonResponse({
          ok: false,
          error: "System is busy processing another fulfillment batch. Please retry.",
          status: "locked"
        }, 429); // 429 Too Many Requests -> D1 Webhook will see this and put orders to 'retry'
      }

      // Lock valid for 60 seconds to prevent deadlocks if Worker crashes
      await KV.put("GLOBAL_FULFILL_LOCK", Date.now().toString(), { expirationTtl: 60 });

      try {
        const body = await request.json();

        // Chuẩn hóa Canonical ID ngay từ đầu vào
        const orderIds = Array.isArray(body.orderIds)
          ? [...new Set(
              body.orderIds
                .filter(x => typeof x === "string" || typeof x === "number")
                .map(x => normalizeOrderId(String(x)))
                .filter(Boolean)
            )]
          : [];

        if (orderIds.length === 0) {
          return jsonResponse({
            ok: true,
            skipped: true
          });
        }

        // ============================================================
        // VÒNG LẶP CHỜ KV ĐỒNG BỘ (Fix Race Condition Eventual Consistency)
        // ============================================================
        let ordersDb = [];
        let retryCount = 0;
        const MAX_RETRIES = 3; // Thử tối đa 3 lần (mỗi lần chờ 2s -> Tổng 6s)

        while (retryCount <= MAX_RETRIES) {
          ordersDb = safeJson(await KV.get("ALL_ORDERS"), []);
          if (!Array.isArray(ordersDb)) ordersDb = [];

          // Kiểm tra xem tất cả các đơn D1 yêu cầu cấp link đã có mặt trong kho KV chưa (Dùng Canonical ID match)
          const allOrdersFound = orderIds.every(oid => ordersDb.some(o => o && normalizeOrderId(o.id) === oid));

          if (allOrdersFound || orderIds.length === 0) {
            break; // Đã tìm thấy đủ kiện hàng, thoát vòng lặp để cấp link!
          }

          if (retryCount < MAX_RETRIES) {
            // Ngủ 2 giây để chờ Cloudflare KV đồng bộ giữa các Datacenter
            await new Promise(resolve => setTimeout(resolve, 2000));
          }
          retryCount++;
        }
        // ============================================================

        let linksDb = safeJson(
          await KV.get("ALL_LINKS"),
          []
        );

        let linkPoolDb = safeJson(
          await KV.get("LINK_POOL"),
          []
        );

        let cmsDb = safeJson(
          await KV.get("ALL_CMS"),
          {}
        );

        if (!Array.isArray(linksDb)) {
          linksDb = [];
        }

        if (!Array.isArray(linkPoolDb)) {
          linkPoolDb = [];
        }

        if (!cmsDb || typeof cmsDb !== "object") {
          cmsDb = {};
        }

        let kvChanged = false;

        const results = {
          fulfilled: [],
          fulfilled_details: [], // 🟢 Trả về chi tiết link cho Webhook D1 Callback
          missing: [],
          already_fulfilled: [],
          errors: []
        };

        // ============================================================
        // MAP SUB WORKER TO PAGES.DEV DOMAINS & XÁC ĐỊNH Ô DÁN LINK ẨN
        // ============================================================
        let PD = url.origin;
        let targetInfoField = "info1"; // Khởi tạo mặc định

        if (PD.includes("doicucden")) {
            PD = "https://vpntrinhhg.pages.dev";
            targetInfoField = "info1"; // Web 1 (doicucden)
        } else if (PD.includes("onepiecechapter")) {
            PD = "https://vpntrinhhg2.pages.dev";
            targetInfoField = "info2"; // Web 2 (onepiecechapter)
        } else if (PD.includes("lucastanora")) {
            PD = "https://vpntrinhhg3.pages.dev";
            targetInfoField = "info3"; // Web 3 (lucastanora)
        }

        // ------------------------------------------------------------
        // Tính USED một lần trước khi cấp.
        // Sau mỗi lần cấp sẽ tăng trực tiếp node.used.
        // ------------------------------------------------------------

        for (const pool of linkPoolDb) {
          pool.used = linksDb.filter(
            x => x && x.orig === pool.url
          ).length;
        }

        // ------------------------------------------------------------
        // PROCESS ORDERS
        // ------------------------------------------------------------

        for (const oid of orderIds) {
          const o = ordersDb.find(
            x => x && normalizeOrderId(x.id) === oid
          );

          // ----------------------------------------------------------
          // 1. Chưa có order metadata (Dù đã chờ 6s)
          // ----------------------------------------------------------

          if (!o) {
            results.missing.push(oid);
            continue;
          }

          // Tự tính date 30 ngày nếu chưa có hạn sử dụng (áp dụng cho cả khi cấp mới và duyệt)
          if (!o.expDate) {
              let startDate = new Date(Date.now() + 7 * 3600 * 1000); // VN Time now
              if (o.date && typeof o.date === "string") {
                  const parts = o.date.match(/(\d{2})\/(\d{2})\/(\d{4})/);
                  if (parts) {
                      startDate = new Date(`${parts[3]}-${parts[2]}-${parts[1]}T00:00:00Z`);
                  }
              }
              startDate.setDate(startDate.getDate() + 30);
              const expDD = String(startDate.getDate()).padStart(2, "0");
              const expMM = String(startDate.getMonth() + 1).padStart(2, "0");
              const expYYYY = startDate.getFullYear();
              o.expDate = `${expDD}/${expMM}/${expYYYY}`;
              kvChanged = true;
          }

          // ----------------------------------------------------------
          // 2. Đã cấp link rồi (Kiểm tra đúng ô info đang được chỉ định)
          // ----------------------------------------------------------

          if (
            o.status === "success" &&
            o[targetInfoField] &&
            typeof o[targetInfoField] === "string" &&
            /^https?:\/\//i.test(o[targetInfoField])
          ) {
            results.already_fulfilled.push(oid);
            continue;
          }

          // ----------------------------------------------------------
          // 3. FIX QUAN TRỌNG:
          // pendingUpgrade đã xử lý thì không được quay lại
          // cấp một link mới ở lần auto_fulfill sau.
          // ----------------------------------------------------------

          if (
            o.upgradeFulfilled === true ||
            o.upgrade_fulfilled === true
          ) {
            results.already_fulfilled.push(oid);
            continue;
          }

          // ----------------------------------------------------------
          // 4. XỬ LÝ NÂNG GÓI
          // ----------------------------------------------------------

          if (o.pendingUpgrade) {
            const upgrade = o.pendingUpgrade;

            if (
              upgrade &&
              typeof upgrade === "object"
            ) {
              if (
                upgrade.amount !== undefined &&
                upgrade.amount !== null
              ) {
                o.totalVnd = upgrade.amount;
              }

              if (upgrade.targetPkg) {
                o.pkgName =
                  String(upgrade.targetPkg)
                    .split(" - ")[0];

                o.pkg =
                  upgrade.targetPkg;
              }

              delete o.pendingUpgrade;

              o.status = "success";

              // Marker chống chạy lại.
              o.upgradeFulfilled = true;

              o.upgradeFulfilledAt =
                new Date().toISOString();

              kvChanged = true;

              results.fulfilled.push(oid);
              results.fulfilled_details.push({ id: oid, link: o[targetInfoField] || "upgraded" }); // Cập nhật webhook payload

              if (
                o.email &&
                cmsDb?.settings?.emailRole === "master"
              ) {
                ctx.waitUntil(
                  sendMail(
                    o.email,
                    "VPN Trinh Hg - Nâng cấp thành công",
                    buildSuccessMailHtml(o, PD)
                  )
                );
              }

              continue;
            }
          }

          // ----------------------------------------------------------
          // 4.5 RỬA PHÈN Ô ZALO (Tẩy mác chưa xác nhận CK)
          // ----------------------------------------------------------
          if (o.zalo && typeof o.zalo === "string") {
            o.zalo = o.zalo.replace("(Chưa xác nhận CK)", "").trim();
          }

          // ----------------------------------------------------------
          // 5. CỨU LINK (KHÁCH CŨ) HOẶC CHỌN NODE MỚI (KHÁCH MỚI)
          // ----------------------------------------------------------
          const prefix = o.email ? String(o.email).split("@")[0] : "Khach";
          const customerLinks = linksDb.filter(l => l && (l.email === prefix || l.email === o.email));

          let existingLink = null;
          if (customerLinks.length > 0) {
              // Bài toán 1: 1 Email nhiều máy -> Chọn Link sắp chết nhất để dồn ngày
              existingLink = customerLinks.sort((a, b) => {
                  const parseD = (d) => {
                      if (String(d).toLowerCase().includes("lifetime")) return Infinity;
                      const m = String(d).match(/(\d{2})\/(\d{2})\/(\d{4})/);
                      if (m) return new Date(`${m[3]}-${m[2]}-${m[1]}T00:00:00Z`).getTime();
                      return 0;
                  };
                  return parseD(a.expDate) - parseD(b.expDate);
              })[0];
          }

          if (existingLink) {
              // ==========================================
              // NGUYÊN TẮC 2: THUẬT TOÁN "CỨU LINK"
              // ==========================================
              const isLife = String(existingLink.expDate || "").toLowerCase().includes("lifetime");
              
              if (!isLife) {
                 // Tính lại HSD cho Link cũ
                 let baseDate = new Date(Date.now() + 7 * 3600 * 1000); // Hôm nay (VN)
                 if (!existingLink.isLocked && existingLink.orig !== "da_het_han" && existingLink.expDate) {
                    const parts = existingLink.expDate.match(/(\d{2})\/(\d{2})\/(\d{4})/);
                    if (parts) {
                        const curExp = new Date(`${parts[3]}-${parts[2]}-${parts[1]}T00:00:00Z`);
                        if (curExp > baseDate) baseDate = curExp; // Nếu vẫn sống -> HSD Mới = HSD Cũ + Ngày gia hạn
                     }
                  }
                 baseDate.setDate(baseDate.getDate() + 30); // Giả định +30 ngày cho đơn gia hạn
                 const expDD = String(baseDate.getDate()).padStart(2, "0");
                 const expMM = String(baseDate.getMonth() + 1).padStart(2, "0");
                 const expYYYY = baseDate.getFullYear();
                 existingLink.expDate = `${expDD}/${expMM}/${expYYYY}`;
              }

              // Hồi sinh (Cấp lại Node)
              if (existingLink.isLocked || existingLink.orig === "da_het_han") {
                 const rescueNode = getPriorityNode(linkPoolDb);
                 if (!rescueNode) {
                    results.errors.push(oid);
                    continue; // Hết Node cứu
                  }
                 existingLink.orig = rescueNode.url;
                 existingLink.isLocked = false;
                 rescueNode.used = Number(rescueNode.used || 0) + 1; // Nhồi Node nội bộ ngay lập tức
              }

              // 🟢 CẬP NHẬT LẠI THÔNG TIN INVENTORY CỦA LINK CŨ
              existingLink.orderId = o.id; 
              existingLink.pkg = o.pkgName || o.pkg || existingLink.pkg || "";
              existingLink.customerName = o.name || o.customerName || existingLink.customerName || prefix;

              // Báo cáo dán link lên Web Admin
              o[targetInfoField] = existingLink.masked;
              o.status = "success";
              o.fulfilledAt = new Date().toISOString();
              kvChanged = true;
              
              results.fulfilled.push(oid);
              results.fulfilled_details.push({ id: oid, link: existingLink.masked }); // 🟢 D1 Callback Payload

              if (o.email && cmsDb?.settings?.emailRole === "master") {
                 ctx.waitUntil(
                     sendMail(
                         o.email,
                         "VPN Trinh Hg - Gia hạn thành công",
                         buildSuccessMailHtml(o, PD)
                     )
                  );
              }
              continue; // Chuyển sang xử lý Đơn hàng tiếp theo
          }

          // ==========================================
          // DÀNH CHO KHÁCH MỚI: BỐC NODE VÀ CẤP LINK ẨN
          // ==========================================
          let node = getPriorityNode(linkPoolDb);

          // ----------------------------------------------------------
          // 6. HẾT NODE
          // ----------------------------------------------------------

          if (!node) {
            results.errors.push(oid); // Chỉ push orderId để tương thích với array mapping ở D1
            continue;
          }

          // ----------------------------------------------------------
          // 7. CẤP LINK
          // ----------------------------------------------------------

          const idx =
            linksDb.filter(
               x => x && x.orig === node.url
            ).length + 1;

          const genHex = (len) => {
            const bytes =
              new Uint8Array(
                Math.ceil(len / 2)
              );

            crypto.getRandomValues(bytes);

            let out = "";

            for (const b of bytes) {
              out += b
                .toString(16)
                .padStart(2, "0");
            }

            return out.slice(0, len);
          };

          let qs;

          if (
            String(node.url).includes("liangxin")
          ) {
            qs = `?OwO=${genHex(32)}`;
          } else {
            qs = `?token=${genHex(32)}`;
          }

          const basePath =
            String(node.url).includes("liangxin")
              ? "/v1/VPNTrinhHg"
              : "/v2/VPNTrinhHg";

          const masked =
             PD +
            basePath +
             qs +
            "#VPNTrinhHg";

          // ----------------------------------------------------------
          // Vietnam time
          // ----------------------------------------------------------

          const vnTime =
            new Date(
              Date.now() + 7 * 3600 * 1000
            );

          const hh =
            String(vnTime.getUTCHours())
              .padStart(2, "0");

          const mm =
            String(vnTime.getUTCMinutes())
              .padStart(2, "0");

          const DD =
            String(vnTime.getUTCDate())
              .padStart(2, "0");

          const MM =
            String(vnTime.getUTCMonth() + 1)
              .padStart(2, "0");

          const YYYY =
            vnTime.getUTCFullYear();

          const dateStr =
            `${hh}:${mm} - ${DD}/${MM}/${YYYY}`;

          // 🟢 BỔ SUNG ĐẦY ĐỦ METADATA CHO INVENTORY TRONG UI ADMIN
          const newLink = {
            id: "LNK-" + Date.now() + genHex(6),
            orderId: o.id,          // Link với mã đơn (Quan trọng)
            pkg: o.pkgName || o.pkg || "",  // Lưu gói cước
            customerName: o.name || o.customerName || prefix,
            orig: node.url,
            masked,
            email: prefix,
            expDate: o.expDate || "",
            linkIndex: String(idx),
            isLocked: false,
            date: dateStr
          };

          linksDb.unshift(newLink);

          // Cực kỳ quan trọng:
          // tăng used ngay trong bộ nhớ để đơn tiếp theo chọn đúng
          node.used =
            Number(node.used || 0) + 1;

          // ========================================================
          // GÁN LINK SUB ẨN VÀO ĐÚNG Ô CỦA WORKER (Web 1/2/3)
          // ========================================================
          o[targetInfoField] = masked;

          o.status = "success";

          o.fulfilledAt =
            new Date().toISOString();

          kvChanged = true;

          results.fulfilled.push(oid);
          results.fulfilled_details.push({ id: oid, link: masked }); // 🟢 D1 Callback Payload

          // ----------------------------------------------------------
          // 8. EMAIL
          // ----------------------------------------------------------

          if (
             o.email &&
            cmsDb?.settings?.emailRole === "master"
          ) {
            ctx.waitUntil(
              sendMail(
                o.email,
                "VPN Trinh Hg - Kích hoạt thành công",
                buildSuccessMailHtml(o, PD)
              )
            );
          }
        }

        // ------------------------------------------------------------
        // 9. SAVE (MỘT LẦN DUY NHẤT LƯU CẢ 3 BẢNG - BẢO ĐẢM INVENTORY)
        // ------------------------------------------------------------

        if (kvChanged) {
          await KV.put(
            "ALL_ORDERS",
            JSON.stringify(ordersDb)
          );

          await KV.put(
            "ALL_LINKS",
            JSON.stringify(linksDb)
          );

          await KV.put(
            "LINK_POOL",
            JSON.stringify(linkPoolDb)
          );

          // ----------------------------------------------------------
          // REBUILD GLOBAL_ROUTER
          // ----------------------------------------------------------

          const globalRouter = {};

          for (const l of linksDb) {
            try {
              if (
                !l ||
                !l.masked ||
                !l.orig
              ) {
                continue;
              }

              const maskUrl =
                new URL(l.masked);

              const origUrl =
                new URL(l.orig);

              const maskTok =
                getP(
                  maskUrl,
                  "OwO",
                  "token"
                );

              const origTok =
                getP(
                  origUrl,
                  "OwO",
                  "token"
                );

              if (
                maskTok &&
                origTok
              ) {
                globalRouter[maskTok] = {
                  origTok,
                  origUrl: l.orig,
                  isLocked: !!l.isLocked
                };
              }

            } catch {
              // Ignore malformed link.
            }
          }

          await KV.put(
            "GLOBAL_ROUTER",
            JSON.stringify(globalRouter)
          );

          // ----------------------------------------------------------
          // ĐỒNG BỘ NGANG (CROSS-WEB TRIGGER)
          // ----------------------------------------------------------
          if (cmsDb?.settings?.crossSyncEnabled) {
             const syncedOrders = [];
             for(const oid of orderIds) {
                 const o = ordersDb.find(x => x && normalizeOrderId(x.id) === oid);
                 if (o && o.status === "success") {
                     syncedOrders.push(o);
                 }
             }

             if (syncedOrders.length > 0) {
                 const rawTargets = [cmsDb.settings.syncW1, cmsDb.settings.syncW2, cmsDb.settings.syncW3].filter(u => u && u.trim());
                 const currentHost = url.hostname;
                 const externalTargets = rawTargets.filter(u => !u.includes(currentHost));

                 for (const target of externalTargets) {
                     const targetUrl = target.replace(/\/$/, '') + "/api/internal/cross_sync_order";
                     ctx.waitUntil(
                         fetch(targetUrl, {
                             method: "POST",
                             headers: {
                                 "Content-Type": "application/json",
                                 "Authorization": `Bearer ${env.WEB_API_SECRET2}`
                             },
                             body: JSON.stringify({ orders: syncedOrders })
                         }).catch(() => {})
                     );
                 }
             }
          }
        }

        return jsonResponse({
          ok: true,
          results
        });

      } catch (e) {
        return jsonResponse({
          ok: false,
          error: e?.message || "Auto fulfillment error"
        }, 500);
      } finally {
        // ALWAYS RELEASE LOCK
        await KV.delete("GLOBAL_FULFILL_LOCK");
      }
    }

    // ================================================================
    // SUBSCRIPTION /v1 /v2
    // ================================================================

    if (
      url.pathname.startsWith("/v1") ||
      url.pathname.startsWith("/v2")
    ) {
      const reqToken =
        getP(
          url,
          "OwO",
          "token"
        );

      const ua =
        request.headers.get("User-Agent") || "";

      const isSingbox =
        /hiddify|sing-box|singbox|nekobox|nekoray|singbox-legacy/i
          .test(ua);

      const isClash =
        !isSingbox &&
        /clash|meta|stash|surfboard|flclash|mihomo|clashmeta/i
          .test(ua);

      const isLiangxinPath =
        url.pathname.startsWith("/v1");

      const rh =
        new Headers({
          ...CORS
        });

      rh.set(
        "profile-title",
        "VPNTrinhHg"
      );

      rh.set(
        "profile-update-interval",
        "2"
      );

      rh.set(
        "Cache-Control",
        "no-store, no-cache, must-revalidate, max-age=0"
      );

      rh.set(
        "Access-Control-Expose-Headers",
        "profile-title,profile-update-interval,subscription-userinfo,Content-Disposition"
      );

      const INFO_NAMES = [
        "🇻🇳 Truy cập web bên dưới",
        "🇻🇳 Để xem thêm gói khác",
        "🌐 Website: vpntrinhhg.pages.dev",
        "📞 Zalo: 0917678211"
      ];

      const VP =
        "vless://00000000-0000-0000-0000-000000000000@127.0.0.1:1?type=tcp#";

      const LOCKED_B64 =
        b64e(
          [
            VP + encodeURIComponent("⛔ Tài khoản bị KHÓA"),
            VP + encodeURIComponent("📞 Zalo: 0917678211")
          ].join("\n")
        );

      const LOCKED_YAML =
        makeSimpleYaml([
          "⛔ Tai khoan bi KHOA",
          "📞 Zalo: 0917678211"
        ]);

      const LOCKED_SB =
        makeSimpleSingbox([
          "⛔ Tai khoan bi KHOA",
          "📞 Zalo: 0917678211"
        ]);

      const DEAD_B64 =
        b64e(
          VP +
          encodeURIComponent(
            "❌ Link không tồn tại - Zalo: 0917678211"
          )
        );

      const DEAD_YAML =
        makeSimpleYaml([
          "❌ Link khong ton tai - Zalo: 0917678211"
        ]);

      const DEAD_SB =
        makeSimpleSingbox([
          "❌ Link khong ton tai - Zalo: 0917678211"
        ]);

      const respond = (
        body,
        fmt,
        info = ""
      ) => {
        if (info) {
          rh.set(
            "subscription-userinfo",
            info
          );
        }

        if (fmt === "yaml") {
          rh.set(
            "Content-Disposition",
            'attachment; filename="VPNTrinhHg.yaml"'
          );

          rh.set(
            "Content-Type",
            "text/yaml; charset=utf-8"
          );

        } else if (fmt === "singbox") {
          rh.set(
            "Content-Disposition",
            'attachment; filename="VPNTrinhHg.json"'
          );

          rh.set(
            "Content-Type",
            "application/json; charset=utf-8"
          );

        } else {
          rh.set(
            "Content-Type",
            "text/plain; charset=utf-8"
          );
        }

        return new Response(
          body,
          {
            status: 200,
            headers: rh
          }
        );
      };

      const getFmt = () =>
        isSingbox
          ? "singbox"
          : (
              isClash
                ? "yaml"
                : "b64"
            );

      const getDead = () => {
        const f = getFmt();

        return respond(
          f === "singbox"
            ? DEAD_SB
            : (
                f === "yaml"
                  ? DEAD_YAML
                  : DEAD_B64
              ),
          f
        );
      };

      const getLocked = () => {
        const f = getFmt();

        return respond(
          f === "singbox"
            ? LOCKED_SB
            : (
                f === "yaml"
                  ? LOCKED_YAML
                  : LOCKED_B64
              ),
          f
        );
      };

      if (!reqToken) {
        return getDead();
      }

      try {
        let routerObj =
          safeJson(
            await KV.get("GLOBAL_ROUTER"),
            {}
          );

        if (
          !routerObj ||
          typeof routerObj !== "object"
        ) {
          routerObj = {};
        }

        const mapping =
          routerObj[reqToken];

        if (!mapping) {
          return getDead();
        }

        if (mapping.isLocked) {
          return getLocked();
        }

        const originToken =
          mapping.origTok;

        const origUrl =
          mapping.origUrl;

        let subsObj =
          safeJson(
            await KV.get("GLOBAL_SUBS"),
            {}
          );

        if (
          !subsObj ||
          typeof subsObj !== "object"
        ) {
          subsObj = {};
        }

        const cachedData =
          subsObj[originToken];

        // ------------------------------------------------------------
        // CACHE
        // ------------------------------------------------------------

        if (cachedData) {
          if (
            isSingbox &&
            cachedData.body_singbox &&
            cachedData.body_singbox.length > 500
          ) {
            return respond(
              cachedData.body_singbox,
              "singbox",
              cachedData.info || ""
            );
          }

          if (
            isClash &&
            cachedData.body_yaml &&
            cachedData.body_yaml.length > 200
          ) {
            return respond(
              cachedData.body_yaml,
              "yaml",
              cachedData.info || ""
            );
          }

          if (
            cachedData.body_b64 &&
            cachedData.body_b64.length > 100
          ) {
            return respond(
              cachedData.body_b64.replace(/\s+/g, ""),
              "b64",
              cachedData.info || ""
            );
          }
        }

        // ------------------------------------------------------------
        // SELF HEALING
        // ------------------------------------------------------------

        if (!origUrl) {
          return getDead();
        }

        const isLiangxin =
          String(origUrl).includes("liangxin");

        const r =
          await fetch(
            origUrl,
            {
              headers: {
                "User-Agent":
                  "v2rayN/6.23"
              },

              cf: {
                cacheTtl: 0,
                cacheEverything: false
              }
            }
          );

        if (!r.ok) {
          return getDead();
        }

        const rawB64 =
          (await r.text())
            .replace(/\s+/g, "");

        const ui =
          r.headers.get(
            "subscription-userinfo"
          ) || "";

        if (
          !rawB64 ||
          rawB64.length < 20
        ) {
          return getDead();
        }

        const {
          newB64,
          yamlStr,
          singboxStr
        } =
          processB64(
            rawB64,
            INFO_NAMES,
            VP,
            isLiangxin
          );

        if (
          !newB64 ||
          newB64.length < 20
        ) {
          return getDead();
        }

        subsObj[originToken] = {
          body_b64: newB64,
          body_yaml: yamlStr,
          body_singbox: singboxStr,
          info: ui
        };

        ctx.waitUntil(
          KV.put(
            "GLOBAL_SUBS",
            JSON.stringify(subsObj)
          )
        );

        if (isSingbox) {
          return (
            singboxStr &&
            singboxStr.length > 500
          )
            ? respond(
                singboxStr,
                "singbox",
                ui
              )
            : getDead();
        }

        if (isClash) {
          return (
            yamlStr &&
            yamlStr.length > 200
          )
            ? respond(
                yamlStr,
                "yaml",
                ui
              )
            : getDead();
        }

        return respond(
          newB64,
          "b64",
          ui
        );

      } catch (e) {
        console.error(
          "Sub error:",
          e?.message || e
        );

        return getDead();
      }
    }

    // ================================================================
    // PUSH DATA FROM PYTHON
    // ================================================================

    if (
      url.pathname === "/api/push_data_batch" &&
      request.method === "POST"
    ) {
      try {
        const batchData =
          await request.text();

        if (!batchData) {
          return new Response(
            "Empty data",
            {
              status: 400,
              headers: CORS
            }
          );
        }

        // Validate JSON trước khi ghi.
        JSON.parse(batchData);

        await KV.put(
          "GLOBAL_SUBS",
          batchData
        );

        return okResp();

      } catch (e) {
        return new Response(
          e?.message || "Push error",
          {
            status: 500,
            headers: CORS
          }
        );
      }
    }

    // ================================================================
    // LINKS
    // ================================================================

    if (url.pathname === "/api/links") {
      if (request.method === "GET") {
        return new Response(
          await KV.get("ALL_LINKS") || "[]",
          {
            status: 200,
            headers: CORS
          }
        );
      }

      if (request.method === "POST") {
        try {
          const text =
            await request.text();

          const links =
            JSON.parse(text);

          if (!Array.isArray(links)) {
            return new Response(
              "ALL_LINKS must be an array",
              {
                status: 400,
                headers: CORS
              }
            );
          }

          await KV.put(
            "ALL_LINKS",
            JSON.stringify(links)
          );

          const globalRouter =
            buildGlobalRouter(links);

          await KV.put(
            "GLOBAL_ROUTER",
            JSON.stringify(globalRouter)
          );

          return okResp();

        } catch (e) {
          return new Response(
            e?.message || "Links error",
            {
              status: 400,
              headers: CORS
            }
          );
        }
      }
    }

    // ================================================================
    // ADMIN KV MAP
    // ================================================================

    const KV_MAP = {
      "/api/orders": [
        "ALL_ORDERS",
        "[]"
      ],

      "/api/deadlinks": [
        "DEAD_LINKS",
        "[]"
      ],

      "/api/cms": [
        "ALL_CMS",
        "{}"
      ],

      "/api/devices": [
        "ADMIN_DEVICES",
        "[]"
      ],

      "/api/accounts": [
        "ALL_ACCOUNTS",
        "[]"
      ],

      "/api/data_requests": [
        "ALL_DATA_REQUESTS",
        "[]"
      ],

      "/api/link_pool": [
        "LINK_POOL",
        "[]"
      ]
    };

    for (
      const [
        path,
        [key, def]
      ] of Object.entries(KV_MAP)
    ) {
      if (url.pathname === path) {
        if (request.method === "GET") {
          return new Response(
            await KV.get(key) || def,
            {
              status: 200,
              headers: CORS
            }
          );
        }

        if (request.method === "POST") {
          const text =
            await request.text();

          // Auto tính date cho mục đơn hàng (ALL_ORDERS)
          if (key === "ALL_ORDERS") {
            try {
              const parsedOrders = JSON.parse(text);
              if (Array.isArray(parsedOrders)) {
                let changed = false;
                for (const o of parsedOrders) {
                  if (o && typeof o === "object") {
                    // Ép chuẩn ID bằng Canonical logic khi lưu Data at rest
                    if (o.id) {
                      const normalizedId = normalizeOrderId(o.id);
                      if (o.id !== normalizedId) {
                        o.id = normalizedId;
                        changed = true;
                      }
                    }

                    if (!o.expDate) {
                      let startDate = new Date(Date.now() + 7 * 3600 * 1000); // Múi giờ VN
                      if (o.date && typeof o.date === "string") {
                        const parts = o.date.match(/(\d{2})\/(\d{2})\/(\d{4})/);
                        if (parts) {
                          startDate = new Date(`${parts[3]}-${parts[2]}-${parts[1]}T00:00:00Z`);
                        }
                      }
                      startDate.setDate(startDate.getDate() + 30); // auto 30 ngày
                      const expDD = String(startDate.getDate()).padStart(2, "0");
                      const expMM = String(startDate.getMonth() + 1).padStart(2, "0");
                      const expYYYY = startDate.getFullYear();
                      o.expDate = `${expDD}/${expMM}/${expYYYY}`;
                      changed = true;
                    }
                  }
                }
                if (changed) {
                  await KV.put(key, JSON.stringify(parsedOrders));
                  return okResp();
                }
              }
            } catch (e) {
              // Bỏ qua lỗi JSON để xuống fallback KV put bên dưới
            }
          }

          await KV.put(
            key,
            text
          );

          return okResp();
        }

        if (request.method === "DELETE") {
          await KV.delete(key);

          return okResp();
        }
      }
    }

    // ================================================================
    // FRONTEND ASSETS
    // ================================================================

    try {
      if (
        env.ASSETS &&
        typeof env.ASSETS.fetch === "function"
      ) {
        return await env.ASSETS.fetch(request);
      }
    } catch (e) {
      console.error(
        "ASSETS error:",
        e?.message || e
      );
    }

    return new Response(
      "API Online - " + url.pathname,
      {
        status: 200,
        headers: CORS
      }
    );
  },

  // ====================================================================
  // CRONJOB TRIGGERED BY CLOUDFLARE (Quét rác & Luân chuyển lúc 2:00 AM)
  // ====================================================================
  async scheduled(event, env, ctx) {
    const KV = env.VPN_KV_TEST || env.VPN_KV;
    if (KV) {
      ctx.waitUntil(runCron(KV));
    }
  }
};

