// ====================================================================
// SING-BOX PROXY CONVERTER
// ====================================================================

function proxyToSingbox(p) {
  if (!p || !p.type) {
    return null;
  }

  // --------------------------------------------------------------
  // VLESS
  // --------------------------------------------------------------

  if (
    p.type === "vless"
  ) {
    const out = {
      type: "vless",

      tag: p.name,

      server:
        p.server,

      server_port:
        Number(p.port) || 443,

      uuid:
        p.uuid
    };

    if (
      p.flow
    ) {
      out.flow =
        p.flow;
    }

    if (
      p.network === "ws" &&
      p["ws-opts"]
    ) {
      out.transport = {
        type: "ws",

        path:
          p["ws-opts"].path ||
          "/",

        headers:
          p["ws-opts"].headers ||
          {}
      };
    }

    else if (
      p.network === "grpc" &&
      p["grpc-opts"]
    ) {
      out.transport = {
        type: "grpc",

        service_name:
          p["grpc-opts"][
            "grpc-service-name"
          ] || ""
      };
    }

    if (
      p.tls
    ) {
      const tls = {
        enabled: true
      };

      if (
        p.servername
      ) {
        tls.server_name =
          p.servername;
      }

      if (
        p["skip-cert-verify"]
      ) {
        tls.insecure = true;
      }

      if (
        p["client-fingerprint"]
      ) {
        tls.utls = {
          enabled: true,
          fingerprint:
            p[
              "client-fingerprint"
            ]
        };
      }

      if (
        p["reality-opts"]
      ) {
        tls.reality = {
          enabled: true,

          public_key:
            p[
              "reality-opts"
            ][
              "public-key"
            ] || "",

          short_id:
            p[
              "reality-opts"
            ][
              "short-id"
            ] || ""
        };
      }

      out.tls = tls;
    }

    return out;
  }

  // --------------------------------------------------------------
  // HYSTERIA2
  // --------------------------------------------------------------

  if (
    p.type === "hysteria2"
  ) {
    const out = {
      type: "hysteria2",

      tag: p.name,

      server:
        p.server,

      server_port:
        Number(p.port) || 443,

      password:
        p.password || ""
    };

    if (
      p.sni ||
      p["skip-cert-verify"]
    ) {
      out.tls = {
        enabled: true,

        server_name:
          p.sni ||
          "",

        insecure:
          !!p[
            "skip-cert-verify"
          ]
      };
    }

    if (
      p.obfs
    ) {
      out.obfs = {
        type:
          p.obfs,

        password:
          p[
            "obfs-password"
          ] || ""
      };
    }

    return out;
  }

  // --------------------------------------------------------------
  // TROJAN
  // --------------------------------------------------------------

  if (
    p.type === "trojan"
  ) {
    const out = {
      type: "trojan",

      tag: p.name,

      server:
        p.server,

      server_port:
        Number(p.port) || 443,

      password:
        p.password || ""
    };

    out.tls = {
      enabled: true,

      server_name:
        p.sni || "",

      insecure:
        !!p[
          "skip-cert-verify"
        ]
    };

    return out;
  }

  return null;
}
