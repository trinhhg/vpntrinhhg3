// ====================================================================
// GLOBAL ROUTER
// ====================================================================

function buildGlobalRouter(links) {
  const globalRouter = {};

  if (!Array.isArray(links)) {
    return globalRouter;
  }

  for (const l of links) {
    try {
      if (
        !l ||
        !l.masked ||
        !l.orig
      ) {
        continue;
      }

      const maskUrl =
        new URL(l.masked);

      const origUrl =
        new URL(l.orig);

      const maskTok =
        getParam(
          maskUrl,
          "OwO",
          "token"
        );

      const origTok =
        getParam(
          origUrl,
          "OwO",
          "token"
        );

      if (
        maskTok &&
        origTok
      ) {
        globalRouter[maskTok] = {
          origTok,
          origUrl: l.orig,
          isLocked: !!l.isLocked
        };
      }

    } catch {
      // Ignore malformed links.
    }
  }

  return globalRouter;
}

function getParam(url, ...keys) {
  for (const key of keys) {
    const value =
      url.searchParams.get(key);

    if (value) {
      return value;
    }
  }

  return null;
}

