// HELPERS CỦA CRONJOB VÀ LUÂN CHUYỂN NODE (Nguyên Tắc 1,3,4,5)
// ====================================================================

// SÁT THỦ DIỆT REGEX FAIL: Dọn dẹp Canonical ID toàn diện
function normalizeOrderId(orderId) {
  return String(orderId || "")
    .trim()
    .toUpperCase()
    .replace(/[-_.\s]/g, ""); // Thổi bay mọi dấu vết ngăn cách
}

// Hàm áp dụng Nguyên tắc 3: Phễu Lọc Ưu Tiên Bốc Node
function getPriorityNode(linkPoolDb) {
    const validNodes = linkPoolDb.filter(pool => {
        if (!pool || !pool.url) return false;
        if (Number(pool.used || 0) >= Number(pool.max || 0)) return false;
        // Điều kiện sống còn: Nếu có thông số dung lượng thì phải >= 100GB
        if (pool.remainGB !== undefined && Number(pool.remainGB) < 100) return false;
        return true;
    });

    if (validNodes.length === 0) return null;

    return validNodes.sort((a, b) => {
        // Xếp hạng Top 1: Slot trống ít nhất lên đầu (để vắt kiệt)
        const slotsA = Number(a.max || 0) - Number(a.used || 0);
        const slotsB = Number(b.max || 0) - Number(b.used || 0);
        if (slotsA !== slotsB) return slotsA - slotsB;

        // Xếp hạng Top 2 & Đáy phễu: Cận HSD nhất -> Xa hơn -> Kim bài Lifetime
        const isLifeA = String(a.exp || "").toLowerCase().includes("lifetime") || !a.exp;
        const isLifeB = String(b.exp || "").toLowerCase().includes("lifetime") || !b.exp;
        if (isLifeA && !isLifeB) return 1; // Lifetime luôn ném xuống chót
        if (!isLifeA && isLifeB) return -1;
        if (isLifeA && isLifeB) return 0;

        const parseD = (d) => {
            const m = String(d).match(/(\d{2})\/(\d{2})\/(\d{4})/);
            if (m) return new Date(`${m[3]}-${m[2]}-${m[1]}T00:00:00Z`).getTime();
            return Infinity;
        };
        return parseD(a.exp) - parseD(b.exp);
    })[0];
}

// Lõi Hệ Thống Tự Động (Chạy lúc 2:00 AM)
async function runCron(KV) {
    let linksDb = safeJson(await KV.get("ALL_LINKS"), []);
    let linkPoolDb = safeJson(await KV.get("LINK_POOL"), []);
    let kvChanged = false;
    let lockedCount = 0;
    let migratedCount = 0;
    let deletedNodes = 0;

    const vnTime = new Date(Date.now() + 7 * 3600 * 1000);
    vnTime.setUTCHours(0, 0, 0, 0); // Về mốc 00:00:00 hôm nay

    const parseDate = (dStr) => {
        const match = String(dStr).match(/(\d{2})\/(\d{2})\/(\d{4})/);
        if (match) return new Date(`${match[3]}-${match[2]}-${match[1]}T00:00:00Z`).getTime();
        return 0;
    };

    // ===================================================
    // NGUYÊN TẮC 1 & 5: QUÉT RÁC & KHÓA HẠN
    // ===================================================
    for (const link of linksDb) {
        const expStr = String(link.expDate || "");
        if (expStr.toLowerCase().includes("lifetime") || !expStr) continue; // Kim bài miễn tử

        const expTime = parseDate(expStr);
        if (expTime > 0 && expTime <= vnTime.getTime()) {
            if (!link.isLocked || link.orig !== "da_het_han") {
               link.isLocked = true;
               link.orig = "da_het_han"; // Đánh dấu chết ngắc
               lockedCount++;
               kvChanged = true;
            }
        }
    }

    // Refresh lại số lượng khách đang bám vào Node
    for (const pool of linkPoolDb) {
        pool.used = linksDb.filter(x => x && x.orig === pool.url).length;
    }

    // ===================================================
    // NGUYÊN TẮC 4: LUÂN CHUYỂN & DỌN DẸP NODE RỖNG
    // ===================================================
    const dyingNodes = [];
    for (const pool of linkPoolDb) {
        const expStr = String(pool.exp || "");
        if (expStr.toLowerCase().includes("lifetime")) continue; // Miễn nhiễm luân chuyển

        let isDying = false;
        const expTime = parseDate(expStr);
        if (expTime > 0 && expTime <= vnTime.getTime() + 86400000) {
            isDying = true; // Hấp hối (<= 1 ngày)
        }
        if (pool.remainGB !== undefined && Number(pool.remainGB) < 100) {
            isDying = true; // Cạn kiệt
        }

        if (isDying) dyingNodes.push(pool);
    }

    for (const dyingNode of dyingNodes) {
        // Lôi cổ khách đang sống ở Node sắp chết ra
        const affectedLinks = linksDb.filter(l => l.orig === dyingNode.url && !l.isLocked);
        let isBroken = false; 

        for (const link of affectedLinks) {
            // Lọc loại trừ các node đang hấp hối khác
            const validPool = linkPoolDb.filter(p => p.url !== dyingNode.url && !dyingNodes.includes(p));
            const targetNode = getPriorityNode(validPool);

            if (!targetNode) {
               isBroken = true;
                break; // VỠ TRẬN! Hủy luân chuyển khách còn lại để giữ yên kết nối mạng.
            }

            link.orig = targetNode.url;
            dyingNode.used--;
            targetNode.used = Number(targetNode.used || 0) + 1;
            migratedCount++;
            kvChanged = true;
        }

        // Bài toán 3: Rút ruột xong Node Nguồn cũng chết -> Tự động xóa vĩnh viễn
        if (!isBroken && Number(dyingNode.used || 0) === 0) {
            linkPoolDb = linkPoolDb.filter(p => p.url !== dyingNode.url);
            deletedNodes++;
            kvChanged = true;
        }
    }

    if (kvChanged) {
        await KV.put("ALL_LINKS", JSON.stringify(linksDb));
        await KV.put("LINK_POOL", JSON.stringify(linkPoolDb));
        
        const globalRouter = buildGlobalRouter(linksDb);
        await KV.put("GLOBAL_ROUTER", JSON.stringify(globalRouter));
    }

    return { lockedCount, migratedCount, deletedNodes };
