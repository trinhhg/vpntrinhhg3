const INFO_SKIP = [
  "剩余流量",
  "距离下次重置",
  "套餐到期"
];

function processB64(
  rawB64,
  infoNames,
  vp,
  isLiangxin
) {
  const decoded =
    decB64(rawB64);

  if (!decoded) {
    return {
      newB64: rawB64,
      yamlStr: "",
      singboxStr: ""
    };
  }

  const lines =
    decoded
      .split(/\r?\n/)
      .map(l => l.trim())
      .filter(l =>
        l.includes("://")
      );

  const newB64Lines =
    infoNames.map(
      n =>
        vp +
        encodeURIComponent(n)
    );

  const proxies = [];

  for (const line of lines) {
    if (
      line.includes(
        "127.0.0.1"
      )
    ) {
      continue;
    }

    const hi =
      line.lastIndexOf("#");

    let name = "";

    if (hi >= 0) {
      name =
        safeDecode(
          line.slice(hi + 1)
        );
    }

    if (!name) {
      name = "VPN Node";
    }

    if (
      INFO_SKIP.some(k =>
        name.includes(k)
      )
    ) {
      continue;
    }

    const base =
      hi >= 0
        ? line.slice(0, hi)
        : line;

    const newName =
      name.includes("VPNTrinhHg")
        ? name
        : `${name} - VPNTrinhHg`;

    const newLine =
      base +
      "#" +
      encodeURIComponent(
        newName
      );

    newB64Lines.push(
      newLine
    );

    const proxy =
      parseURI(newLine);

    if (
      proxy &&
      proxy.server &&
      proxy.name
    ) {
      proxies.push(proxy);
    }
  }

  const newB64 =
    encB64(
      newB64Lines.join("\n")
    );

  const yamlStr =
    proxies.length
      ? buildYaml(
          proxies,
          infoNames,
          isLiangxin
        )
      : "";

  const singboxStr =
    proxies.length
      ? buildSingboxFull(
          proxies,
          infoNames,
          isLiangxin
        )
      : "";

  return {
    newB64,
    yamlStr,
    singboxStr
  };
}

// ====================================================================
// URI PARSER
// ====================================================================

function safeDecode(value) {
  try {
    return decodeURIComponent(
      value
    );
  } catch {
    return value;
  }
}

function parseURI(line) {
  try {
    const hi =
      line.lastIndexOf("#");

    const name =
      hi >= 0
        ? safeDecode(
            line.slice(hi + 1)
          )
        : "";

    const base =
      hi >= 0
        ? line.slice(0, hi)
        : line;

    const u =
      new URL(base);

    const p = {};

    u.searchParams.forEach(
      (v, k) => {
        p[k] = v;
      }
    );

    const proto =
      u.protocol
        .replace(":", "")
        .toLowerCase();

    // --------------------------------------------------------------
    // HYSTERIA2
    // --------------------------------------------------------------

    if (
      proto === "hysteria2" ||
      proto === "hy2"
    ) {
      const proxy = {
        name,
        type: "hysteria2",
        server: u.hostname,
        port:
          parseInt(u.port) || 443,
        password:
          safeDecode(
            u.username || ""
          ),
        udp: true
      };

      if (
        p.insecure === "1"
      ) {
        proxy[
          "skip-cert-verify"
        ] = true;
      }

      if (p.sni) {
        proxy.sni = p.sni;
      }

      if (p.obfs) {
        proxy.obfs = p.obfs;
      }

      if (p["obfs-password"]) {
        proxy[
          "obfs-password"
        ] = safeDecode(
          p["obfs-password"]
        );
      }

      if (p.mport) {
        proxy.mport = p.mport;
      }

      return proxy;
    }

    // --------------------------------------------------------------
    // VLESS
    // --------------------------------------------------------------

    if (proto === "vless") {
      const sec =
        (
          p.security ||
          "none"
        ).toLowerCase();

      const net =
        (
          p.type ||
          "tcp"
        ).toLowerCase();

      const proxy = {
        name,
        type: "vless",
        server: u.hostname,
        port:
          parseInt(u.port) || 443,
        uuid:
          safeDecode(
            u.username || ""
          ),
        udp: true
      };

      proxy.tls =
        sec === "tls" ||
        sec === "reality";

      if (
        p.insecure === "1"
      ) {
        proxy[
          "skip-cert-verify"
        ] = true;
      }

      if (p.flow) {
        proxy.flow = p.flow;
      }

      if (p.fp) {
        proxy[
          "client-fingerprint"
        ] = p.fp;
      }

      if (p.sni) {
        proxy.servername =
          p.sni;
      }

      // REALITY
      if (sec === "reality") {
        const ro = {};

        if (p.pbk) {
          ro[
            "public-key"
          ] = p.pbk;
        }

        if (p.sid) {
          ro[
            "short-id"
          ] = p.sid;
        }

        if (
          Object.keys(ro).length
        ) {
          proxy[
            "reality-opts"
          ] = ro;
        }
      }

      // WebSocket
      if (net === "ws") {
        proxy.network = "ws";

        proxy[
          "ws-opts"
        ] = {
          path:
            safeDecode(
              p.path || "/"
            ),

          headers: {
            Host:
              p.host ||
              u.hostname
          }
        };
      }

      // gRPC
      else if (
        net === "grpc"
      ) {
        proxy.network =
          "grpc";

        proxy[
          "grpc-opts"
        ] = {
          "grpc-service-name":
            p.serviceName ||
            ""
        };
      }

      return proxy;
    }

    // --------------------------------------------------------------
    // TROJAN
    // --------------------------------------------------------------

    if (
      proto === "trojan"
    ) {
      return {
        name,
        type: "trojan",
        server: u.hostname,
        port:
          parseInt(u.port) || 443,
        password:
          safeDecode(
            u.username || ""
          ),
        udp: true,

        ...(p.sni
          ? {
              sni: p.sni
            }
          : {}),

        ...(p.allowInsecure === "1"
          ? {
              "skip-cert-verify": true
            }
          : {})
      };
    }

  } catch {
    return null;
  }

  return null;
}

