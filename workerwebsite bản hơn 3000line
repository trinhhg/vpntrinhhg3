function proxyToInline(p) {
  const out = {
    name: p.name,
    type: p.type,
    server: p.server,
    port: Number(p.port)
  };

  if (p.type === "vless") {
    out.uuid = p.uuid;
    out.udp = p.udp !== false;

    if (p.tls) {
      out.tls = true;
    }

    if (p["skip-cert-verify"]) {
      out["skip-cert-verify"] = true;
    }

    if (p.flow) {
      out.flow = p.flow;
    }

    if (p["client-fingerprint"]) {
      out["client-fingerprint"] =
        p["client-fingerprint"];
    }

    if (p.servername) {
      out.servername =
        p.servername;
    }

    if (p["reality-opts"]) {
      out["reality-opts"] =
        p["reality-opts"];
    }

    if (p.network) {
      out.network =
        p.network;
    }

    if (p["ws-opts"]) {
      out["ws-opts"] =
        p["ws-opts"];
    }

    if (p["grpc-opts"]) {
      out["grpc-opts"] =
        p["grpc-opts"];
    }
  }

  else if (
    p.type === "hysteria2"
  ) {
    out.password =
      p.password;

    out.udp =
      p.udp !== false;

    if (p.sni) {
      out.sni =
        p.sni;
    }

    if (
      p["skip-cert-verify"]
    ) {
      out["skip-cert-verify"] =
        true;
    }

    if (p.obfs) {
      out.obfs =
        p.obfs;
    }

    if (
      p["obfs-password"]
    ) {
      out["obfs-password"] =
        p["obfs-password"];
    }

    if (p.mport) {
      out.mport =
        p.mport;
    }
  }

  else if (
    p.type === "trojan"
  ) {
    out.password =
      p.password;

    out.udp =
      p.udp !== false;

    if (p.sni) {
      out.sni =
        p.sni;
    }

    if (
      p["skip-cert-verify"]
    ) {
      out["skip-cert-verify"] =
        true;
    }
  }

  return `    - ${JSON.stringify(out)}`;
}

