function buildYaml(
  proxies,
  infoNames,
  isLiangxin
) {
  const allProxies = [];

  // --------------------------------------------------------------
  // INFO NODES
  // --------------------------------------------------------------

  for (const n of infoNames) {
    const infoProxy = {
      name: n,
      type: "vless",
      server: "127.0.0.1",
      port: 1,
      uuid:
        "00000000-0000-0000-0000-000000000000",
      udp: false
    };

    allProxies.push(
      `    - ${JSON.stringify(infoProxy)}`
    );
  }

  // --------------------------------------------------------------
  // REAL NODES
  // --------------------------------------------------------------

  for (const p of proxies) {
    allProxies.push(
      proxyToInline(p)
    );
  }

  const realNames =
    proxies
      .map(
        p =>
          yamlQuote(p.name)
      )
      .join(", ");

  const allNames =
    [
      ...infoNames.map(
        n => yamlQuote(n)
      ),
      ...proxies.map(
        p => yamlQuote(p.name)
      )
    ].join(", ");

  const dnsBlock =
    isLiangxin
      ? LIANGXIN_DNS_STR
      : DJJC_DNS_STR;

  const rules =
    isLiangxin
      ? LIANGXIN_RULES
      : DJJC_RULES;

  const lines = [
    "mixed-port: 7890",
    "allow-lan: false",
    "bind-address: '*'",
    "mode: rule",
    "log-level: info",
    "external-controller: '127.0.0.1:9090'",
    "unified-delay: true",
    "tcp-concurrent: true",

    dnsBlock,

    "proxies:",
    ...allProxies,

    "proxy-groups:",

    `    - { name: "VPN Trinh Hg", type: select, proxies: ["Auto Select", "Fallback", ${allNames}] }`,

    `    - { name: "Auto Select", type: url-test, proxies: [${realNames}], url: "http://www.gstatic.com/generate_204", interval: 86400, tolerance: 50 }`,

    `    - { name: "Fallback", type: fallback, proxies: [${realNames}], url: "http://www.gstatic.com/generate_204", interval: 7200 }`,

    "rules:"
  ];

  for (const r of rules) {
    lines.push(
      `    - ${JSON.stringify(r)}`
    );
  }

  return lines.join("\n");
}

