// ====================================================================
// BASE64
// ====================================================================

function decB64(str) {
  try {
    const clean =
      String(str || "")
        .replace(/\s+/g, "");

    if (!clean) {
      return "";
    }

    const padded =
      clean +
      "=".repeat(
        (4 - (clean.length % 4)) % 4
      );

    const bin =
      atob(padded);

    const bytes =
      new Uint8Array(
        bin.length
      );

    for (
      let i = 0;
      i < bin.length;
      i++
    ) {
      bytes[i] =
        bin.charCodeAt(i);
    }

    return new TextDecoder(
      "utf-8"
    ).decode(bytes);

  } catch {
    return "";
  }
}

function encB64(str) {
  const bytes =
    new TextEncoder().encode(
      String(str ?? "")
    );

  let bin = "";

  for (const b of bytes) {
    bin += String.fromCharCode(b);
  }

  return btoa(bin);
}

